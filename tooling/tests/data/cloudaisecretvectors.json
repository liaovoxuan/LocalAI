{
  "format": "cloudai-secret-v1",
  "description": "Cross-language golden vectors for the CloudAI v1 secret format.",
  "algorithm": "value = 'v1:' + base64_standard(utf8_bytes XOR salt[i % len(salt)])",
  "canonical_salt_utf8": "CloudAI",
  "encoding": "base64-standard-with-padding",
  "consumers": [
    "projects/LocalAI/desktop/cloudsecrets.py",
    "projects/CloudAI/source/python/cloudai.py",
    "projects/CloudAI/source/cpp/src/CloudAIHarmony.cpp"
  ],
  "vectors": [
    {
      "plaintext": "sk-proj-EXAMPLE1234567890",
      "blob": "v1:MAdCBRYuI24pNzQpEQUGXV1GUHR/dFRWRQ=="
    },
    {
      "plaintext": "sk-abcdefghijklmnopqrstuvwxyz",
      "blob": "v1:MAdCFAYiLSYKCB0NKyIvAQEaFDA7MBgaAxM5MDk="
    },
    {
      "plaintext": "dummy",
      "blob": "v1:JxkCGB0="
    },
    {
      "plaintext": "AIzaSyD-EXAMPLE-KEY-0001",
      "blob": "v1:AiUVFDc4DW4pNzQpEQUGQSQwPWx5c1xe"
    },
    {
      "plaintext": "sk-or-v1-0123456789abcdef0123456789abcdef",
      "blob": "v1:MAdCGhZsP3JBX0RWcn12WlhNXSArIAgKE1Rwe3BYWkNTeXAiDgwRASc="
    },
    {
      "plaintext": "密钥-unicode-测试-0123456789",
      "blob": "v1:psPpnPbkZDYCBhYLJSxuitr+jO7cblxeR1d1fHVbV0w="
    }
  ],
  "legacy_hostname_vectors": [
    {
      "hostname_salt": "cloudai-legacy-host.example",
      "plaintext": "sk-proj-EXAMPLE1234567890",
      "blob": "v1:EAdCBRYOAwApPSYsMzVoWV1AQBtTT1lUQA=="
    },
    {
      "hostname_salt": "cloudai-legacy-host.example",
      "plaintext": "legacy-hostname-key-9999",
      "blob": "v1:DwkIFAcYREUDFhMPAhRIRQQWDQNcQVhU"
    }
  ],
  "note": "legacy_hostname_vectors reproduce the CloudAI 1.0.1 desktop format that used platform.node() as salt; strict decode must reject them and the migration fallback must recover them."
}
