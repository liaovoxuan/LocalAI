+static void UTMQemuSendInputEvents(QEMUMonitor *monitor, NSArray<NSDictionary *> *events, NSString *label, void (^completion)(BOOL)) {
+    if (!monitor || !monitor.isConnected || events.count == 0) {
+        if (completion) {
+            completion(NO);
+        }
+        return;
+    }
+    dispatch_queue_t monitorQueue = monitor.monitorQueue;
+    if (!monitorQueue) {
+        UTMPumaInputLog([NSString stringWithFormat:@"QMP input-send-event %@ skipped: monitor queue unavailable", label]);
