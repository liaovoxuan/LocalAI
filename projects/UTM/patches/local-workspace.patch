+void UTMQemuSendMouseButton(QEMUMonitor *monitor, NSUInteger button, BOOL pressed) {
+    if (!monitor || !monitor.isConnected) {
+        return;
+    }
+    NSString *buttonName;
+    switch (button) {
+        case 1: buttonName = @"left"; break;
+        case 2: buttonName = @"right"; break;
+        case 4: buttonName = @"middle"; break;
