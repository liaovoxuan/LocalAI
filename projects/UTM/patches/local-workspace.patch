+                pendingX = UTMClassicMacPendingDeltaX;
+                pendingY = UTMClassicMacPendingDeltaY;
+                UTMClassicMacPendingDeltaX = 0;
+                UTMClassicMacPendingDeltaY = 0;
+                pendingMonitor = UTMClassicMacPendingMonitor;
+                if (pendingX == 0 && pendingY == 0) {
+                    UTMClassicMacMouseWorkerScheduled = NO;
+                    UTMClassicMacPendingMonitor = nil;
+                    break;
+                }
+            }
+            if (!pendingMonitor || !pendingMonitor.isConnected) {
