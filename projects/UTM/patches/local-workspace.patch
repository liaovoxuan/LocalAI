 NSString *const kUTMErrorDomain = @"com.utmapp.utm";
 
+// QEMUKit exposes the monitor queue and its QMP transport only to the
+// QEMUKitInternal target.  The public QEMUMonitor API currently contains
+// query_mice/mouse_set but not input-send-event, which is the only QMP command
+// that can represent relative axes and explicit key/button up/down events.
+// Keep the bridge local to UTM and use the same serialized queue/RPC helper as
+// QEMUKit, instead of opening a second monitor connection (which would race
+// QEMUKit's response dispatcher).
+typedef struct Error Error;
+extern void qmp_rpc_call(CFDictionaryRef args, CFDictionaryRef *ret, Error **err, void *ctx);
+extern const char *error_get_pretty(const Error *err);
+extern void error_free(Error *err);
+
+@interface QEMUMonitor (UTMPumaPrivateTransport)
+@property (nonatomic, readonly) dispatch_queue_t monitorQueue;
+@end
+
+static dispatch_queue_t UTMClassicMacMouseQueue(void) {
+    static dispatch_queue_t queue;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        dispatch_queue_attr_t attr = dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                                              QOS_CLASS_USER_INTERACTIVE,
