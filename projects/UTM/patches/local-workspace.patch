+    // Run the RPC on QEMUKit's own serialized monitor queue and wait for it
+    // before returning.  The caller coalesces deltas while this request is in
+    // flight; dispatching and immediately returning would let a fast pointer
+    // generate an unbounded backlog of monitor requests.
+    __block BOOL success = NO;
+    dispatch_sync(monitorQueue, ^{
+        NSDictionary *command = @{
+            @"execute": @"input-send-event",
+            @"arguments": @{ @"events": events }
+        };
+        Error *qerr = NULL;
+        qmp_rpc_call((__bridge CFDictionaryRef)command, NULL, &qerr, (__bridge void *)monitor);
+        success = qerr == NULL;
+        if (qerr) {
+            const char *message = error_get_pretty(qerr);
+            NSString *description = message ? [NSString stringWithUTF8String:message] : @"unknown QMP error";
+            UTMPumaInputLog([NSString stringWithFormat:@"QMP input-send-event %@ failed: %@", label, description]);
+            error_free(qerr);
+        }
+    });
+    if (completion) {
+        completion(success);
+    }
