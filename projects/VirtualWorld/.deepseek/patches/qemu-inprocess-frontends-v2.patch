-    int (*audio_in)(void *userdata, int16_t *samples,
-                    size_t frames, int channels, int rate);
+    int (*audio_setup_in)(void *userdata,
+                          const struct QemuInProcessAudioParams *wanted,
+                          struct QemuInProcessAudioParams *granted);
+    void (*audio_release_in)(void *userdata);
+    /* Fills `frames`; returns frames actually produced (short read allowed). */
+    uint32_t (*audio_in)(void *userdata, void *samples, uint32_t frames);
 
