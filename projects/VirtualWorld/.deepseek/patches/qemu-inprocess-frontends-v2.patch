-    void (*audio_out)(void *userdata, const int16_t *samples,
-                      size_t frames, int channels, int rate);
+    /* Audio: format is NEGOTIATED ONCE, in setup, not per call. */
+    int (*audio_setup_out)(void *userdata,
+                           const struct QemuInProcessAudioParams *wanted,
+                           struct QemuInProcessAudioParams *granted);
+    void (*audio_release_out)(void *userdata);
+    /* Returns the number of frames actually consumed (backpressure). A return
