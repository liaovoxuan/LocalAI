-    void (*display_update)(void *userdata, const void *pixels,
-                          int w, int h, int stride, int format);
+    /* Display mode changed (resolution and/or pixel format). Sent before the
+     * first present for the new mode. pixel_format is a
+     * QemuInProcessPixelFormat value. */
+    void (*display_mode)(void *userdata, int32_t width, int32_t height,
+                         uint32_t pixel_format);
 
-    /* Input: host forwards a guest input event (serialised by the host).
-     * Returns 0 if accepted. */
-    int (*input_event)(void *userdata, const void *event, size_t len);
+    /* A frame is available. Valid ONLY during this call (see LIFETIME).
+     *   stride : BYTES per row; NEGATIVE means bottom-up (row 0 is the last
+     *            memory row). May exceed width*bytes_per_pixel.
+     *   pixel_format : QemuInProcessPixelFormat. The glue maps QEMU's
+     *            pixman format explicitly; it never assumes RGBA8.
+     *   seq : monotonically increasing frame counter. */
+    void (*display_present)(void *userdata, const void *pixels,
