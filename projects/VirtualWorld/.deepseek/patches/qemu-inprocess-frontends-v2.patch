+    /* Block: BYTE offset/length (not sectors), 0 or -errno.
+     * offset/length are NOT guaranteed 512-aligned (QEMU drops
+     * request_alignment to 1 when bdrv_co_preadv is implemented); the glue
+     * must either set BDRV_SECTOR_SIZE alignment or do read-modify-write.
+     * disk_id is host-assigned; the glue passes it through from the driver
