+/*
+ * Frontend callback contract -- ABI v2.
+ *
+ * THREADING (v2, corrected): callbacks are NOT uniformly "worker/IO threads".
+ * Real contexts, measured against QEMU 11.1.50:
+ *   display_present  : main-loop thread (timer-driven refresh) AND vCPU thread
+ *                      holding the BQL (guest virtio-gpu set_scanout). The
+ *                      implementation must be safe on both.
+ *   audio_*          : main-loop thread, BQL HELD.
+ *   block_*          : block-layer coroutine, BQL held; the glue yields the
+ *                      coroutine to a thread-pool worker before calling in.
+ *   input_*          : REMOVED as a callback -- see the host->guest API below.
+ *                      A callback cannot express host->guest input; the old
+ *                      input_event was directionally wrong.
+ *
+ * LIFETIME (v2, corrected): display bytes are valid ONLY for the duration of
+ * the call. QEMU frees the previous DisplaySurface immediately after
+ * gfx_switch returns, so the host MUST copy synchronously. Retaining the
+ * pointer is a use-after-free, not a "may change later".
+ */
 typedef struct QemuInProcessCallbacks {
     void *userdata;
 
-    /* Display: QEMU produced a frame; host blits it.
-     *   pixels : pointer to a w*h*4 (RGBA, stride bytes/row) buffer
