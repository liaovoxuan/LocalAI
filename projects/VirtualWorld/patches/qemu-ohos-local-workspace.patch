+/*
+ * ASan keeps every freed chunk in its quarantine for a while, so in a
+ * 100-cycle same-PID run the sanitizer's *bounded* quarantine fill-up alone
+ * looks like a linear RSS growth (measured: ~30 MiB with the default
+ * quarantine).  That is sanitizer bookkeeping, not QEMU state: purge it after
+ * each cycle so the RSS probes measure the real per-cycle footprint.  The
+ * quarantine still works within a cycle, where every QEMU lifetime bug is
+ * detected; and a purge only returns already-freed memory, it does not change
+ * what the sanitizer treats as freed.  No-op when the binary is not
+ * sanitizer-instrumented (the symbol is absent).
+ */
+static void sanitizer_purge_allocator(void)
+{
+    static void (*purge)(void);
+    static int resolved;
+
+    if (!resolved) {
+        resolved = 1;
+        purge = (void (*)(void))(uintptr_t)dlsym(RTLD_DEFAULT,
+                                                "__sanitizer_purge_allocator");
+    }
+    if (purge) {
+        purge();
+    }
+}
