+        unsigned long ioff = 0;
+
+        if (e && e->init_site && dladdr(e->init_site, &di)) {
+            isym = di.dli_sname ? di.dli_sname : "?";
+            ioff = (unsigned long)((uintptr_t)e->init_site -
+                                   (uintptr_t)di.dli_saddr);
