diff --git a/hw/core/bus.c b/hw/core/bus.c
index 53f392fdda842dbeb3773153b6b1a6721cc0b686..1a4210e5cfc2d4bd7f51c5e7537e4294712693b5 100644
--- a/hw/core/bus.c
+++ b/hw/core/bus.c
@@ -135,21 +135,51 @@ static void qbus_init_internal(BusState *bus, DeviceState *parent,
     }
 }
 
+/*
+ * VirtualWorld: unparent every device on @bus, newest first.
+ *
+ * Device creation order is recorded by the bus child list (bus_add_child()
+ * inserts at the head), and links between devices are created after both ends
+ * exist.  Unparenting newest-first therefore releases a device's links (e.g.
+ * "sysbus-irq[N]" -> another device's GPIO IRQ state) while the objects they
+ * point at are still alive.  Tearing the tree down in QOM hash-table order
+ * instead frees the target first, and the linking device then unrefs a dangling
+ * strong link (object_unref: assertion failed / EXC_BAD_ACCESS in
+ * bus_free_bus_child on the RCU thread).
+ *
+ * The in-process (embedded) lifecycle calls this from qemu_cleanup() before it
+ * finalizes the machine; upstream never needs it because it exits.
+ */
+void qbus_unparent_all_children(BusState *bus)
+{
+    BusChild *kid;
+
+    while ((kid = QTAILQ_FIRST(&bus->children)) != NULL) {
+        object_unparent(OBJECT(kid->child));
+    }
+}
+
 static void bus_unparent(Object *obj)
 {
     BusState *bus = BUS(obj);
-    BusChild *kid;
 
-    /* Only the main system bus has no parent, and that bus is never freed */
-    assert(bus->parent);
+    /*
+     * Upstream: "Only the main system bus has no parent, and that bus is never
+     * freed", so the assert below holds.  In the in-process lifecycle the whole
+     * machine tree is finalized by qemu_cleanup() while the process keeps
+     * running, which unparents the main system bus as well.  There is nothing
+     * to detach in that case: the bus simply has no parent bus.
+     */
+    if (!bus->parent) {
+        assert(bus == sysbus_get_default());
+    }
 
-    while ((kid = QTAILQ_FIRST(&bus->children)) != NULL) {
-        DeviceState *dev = kid->child;
-        object_unparent(OBJECT(dev));
+    qbus_unparent_all_children(bus);
+    if (bus->parent) {
+        QLIST_REMOVE(bus, sibling);
+        bus->parent->num_child_bus--;
+        bus->parent = NULL;
     }
-    QLIST_REMOVE(bus, sibling);
-    bus->parent->num_child_bus--;
-    bus->parent = NULL;
 }
 
