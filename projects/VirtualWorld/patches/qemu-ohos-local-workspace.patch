+     * iohandler_ctx is a process-lifetime singleton, a dispatcher coroutine
+     * scheduled by a *previous* (possibly failed) qemu_init() can still be
+     * pending when a new dispatcher is created; qmp_dispatcher_co then points
+     * at the new coroutine.  Any stale coroutine must exit immediately without
+     * touching the shared busy/shutdown globals, otherwise it corrupts the
+     * invariant that the current dispatcher relies on.
+     */
+    if (qmp_dispatcher_co != qemu_coroutine_self()) {
+        return;
+    }
+
