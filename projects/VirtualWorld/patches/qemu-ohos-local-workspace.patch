+/* Minimal async-signal-safe-ish output helpers: no stdio, no allocation, no
+ * locks (a hung thread may hold the libc/malloc/stdio locks). */
+static void diag_puts(const char *s)
+{
+    size_t n = strlen(s);
+    ssize_t ignored = write(2, s, n);
+
+    (void)ignored;
+}
+
+static void diag_puthex(uint64_t v)
+{
+    char out[19];
+    int i;
+
+    out[0] = '0';
+    out[1] = 'x';
+    for (i = 0; i < 16; i++) {
+        unsigned d = (unsigned)((v >> ((15 - i) * 4)) & 0xf);
+
+        out[2 + i] = (char)(d < 10 ? '0' + d : 'a' + d - 10);
+    }
+    out[18] = '\0';
+    diag_puts(out);
+}
+
+static void diag_putdec(uint64_t v)
+{
+    char out[21];
+    int i = 20;
+
+    out[i] = '\0';
+    do {
+        out[--i] = (char)('0' + (v % 10));
+        v /= 10;
+    } while (v && i > 0);
+    diag_puts(&out[i]);
+}
+
+/* Backtrace of the thread that received the diagnostic signal (VW_DUMP_STACKS).
+ * This runs in the interrupted thread's own context, so it can unwind the
+ * stack that is actually stuck.  Raw addresses are printed (no dladdr / no
+ * stdio, which could take the locks the hung thread holds); symbolize offline
+ * with atos/llvm-symbolizer using the image_base + slide printed by the dump. */
+static void diag_stack_handler(int sig, siginfo_t *si, void *ucp)
+{
+    void *frames[96];
+    int n;
+    int i;
+    ucontext_t *uc = (ucontext_t *)ucp;
+    uint64_t pc = 0, lr = 0, sp = 0, fp = 0;
+
+    (void)si;
+#if defined(__arm64__) && defined(__APPLE__)
+    if (uc && uc->uc_mcontext) {
+        arm_thread_state64_t *ss = &uc->uc_mcontext->__ss;
+
+        pc = ss->__pc;
+        lr = ss->__lr;
+        sp = ss->__sp;
+        fp = ss->__fp;
+    }
+#endif
+    diag_puts("[stackdump] sig=");
+    diag_putdec((uint64_t)sig);
+    diag_puts(" stage=\"");
+    diag_puts(g_stage);
+    diag_puts("\"\n[stackdump] interrupted pc=");
+    diag_puthex(pc);
+    diag_puts(" lr=");
+    diag_puthex(lr);
+    diag_puts(" sp=");
+    diag_puthex(sp);
+    diag_puts(" fp=");
+    diag_puthex(fp);
+    diag_puts("\n[stackdump] backtrace:\n");
+    n = backtrace(frames, 96);
+    for (i = 0; i < n; i++) {
+        diag_puts("[stackdump]   #");
+        diag_putdec((uint64_t)i);
+        diag_puts(" ");
+        diag_puthex((uint64_t)(uintptr_t)frames[i]);
+        diag_puts("\n");
+    }
+    diag_puts("[stackdump] end\n");
+}
+
+#if defined(__APPLE__)
+/* Send the diagnostic signal to every thread of this process so each one prints
+ * its own backtrace from its own (interrupted) context. */
+static void stack_dump_all_threads(void)
+{
+    thread_act_array_t threads;
+    mach_msg_type_number_t nthreads = 0;
+
+    if (task_threads(mach_task_self(), &threads, &nthreads) != KERN_SUCCESS) {
+        return;
+    }
+    fprintf(stderr, "[stackdump] requesting backtrace of %u threads "
+            "(stage=\"%s\")\n", nthreads, g_stage);
+    for (mach_msg_type_number_t i = 0; i < nthreads; i++) {
+        pthread_t pt = pthread_from_mach_thread_np(threads[i]);
+
+        if (pt) {
+            pthread_kill(pt, SIGUSR2);
+        }
+        mach_port_deallocate(mach_task_self(), threads[i]);
+    }
+    vm_deallocate(mach_task_self(), (vm_address_t)threads,
+                  nthreads * sizeof(threads[0]));
+    /* Give the handlers time to write their stacks out before we abort. */
+    {
+        struct timespec ts = { 2, 0 };
+
+        nanosleep(&ts, NULL);
+    }
+}
+#else
+static void stack_dump_all_threads(void) { }
+#endif
+
+#if defined(__APPLE__)
+static void dump_all_thread_pcs(void)
+{
+    thread_act_array_t threads;
+    mach_msg_type_number_t nthreads = 0;
+    Dl_info main_info = { 0 };
+
+    dladdr((void *)(uintptr_t)&main, &main_info);
+    fprintf(stderr, "[timeout] stage=\"%s\"\n", g_stage);
+    fprintf(stderr, "[timeout] image_base=%p slide=%p main=%p\n",
+            main_info.dli_fbase,
+            (void *)(uintptr_t)_dyld_get_image_vmaddr_slide(0),
+            (void *)(uintptr_t)&main);
+    if (task_threads(mach_task_self(), &threads, &nthreads) != KERN_SUCCESS) {
+        return;
+    }
+    fprintf(stderr, "[timeout] live_threads=%u\n", nthreads);
+    for (mach_msg_type_number_t i = 0; i < nthreads; i++) {
+        arm_thread_state64_t st;
+        mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+
+        if (thread_get_state(threads[i], ARM_THREAD_STATE64,
+                             (thread_state_t)&st, &count) == KERN_SUCCESS) {
+            Dl_info inf = { 0 };
+            const char *im = "?";
+            const char *sym = "";
+            unsigned long off = 0;
+
+            if (dladdr((void *)st.__pc, &inf)) {
+                im = inf.dli_fname ? strrchr(inf.dli_fname, '/') : NULL;
+                im = im ? im + 1 : (inf.dli_fname ? inf.dli_fname : "?");
+                if (inf.dli_sname) {
+                    sym = inf.dli_sname;
+                    off = (unsigned long)(st.__pc
+                                          - (uintptr_t)inf.dli_saddr);
+                } else {
+                    off = (unsigned long)(st.__pc
+                                          - (uintptr_t)inf.dli_fbase);
+                }
+            }
+            fprintf(stderr, "[timeout] thread %u pc=%p lr=%p sp=%p %s+0x%lx "
+                    "%s\n", i, (void *)st.__pc, (void *)st.__lr,
+                    (void *)st.__sp, im, off, sym);
+        }
+        mach_port_deallocate(mach_task_self(), threads[i]);
+    }
+    vm_deallocate(mach_task_self(), (vm_address_t)threads,
+                  nthreads * sizeof(threads[0]));
+}
+#else
+static void dump_all_thread_pcs(void) { }
+#endif
