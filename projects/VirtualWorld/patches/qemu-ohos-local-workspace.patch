+{
+    GHashTableIter iter;
+    ObjectProperty *prop;
+    int bad = 0;
+
+    if (!qemu_inprocess_object_is_live(obj)) {
+        return 0;            /* caller already reported this object */
+    }
+    g_hash_table_iter_init(&iter, obj->properties);
+    while (g_hash_table_iter_next(&iter, NULL, (gpointer *)&prop)) {
+        Object *child;
+
+        if (!object_property_is_child(prop)) {
+            continue;
+        }
+        child = prop->opaque;
+        if (!child || !qemu_inprocess_object_is_live(child)) {
+            bad++;
+            if (*reported < 20) {
+                fprintf(stderr, "[vwqom] DEAD CHILD parent=%s(%p) prop=%s "
+                        "child=%p depth=%d\n", object_get_typename(obj),
+                        (void *)obj, prop->name, (void *)child, depth);
+                (*reported)++;
+            }
+            continue;
+        }
+        bad += vw_qom_walk(child, depth + 1, reported);
+    }
+    return bad;
+}
