diff --git a/ohos/vw_nojit_guard.c b/ohos/vw_nojit_guard.c
new file mode 100644
index 0000000000000000000000000000000000000000..e4e0c3eab480cb93d1728aa712c910b613319b82
--- /dev/null
+++ b/ohos/vw_nojit_guard.c
@@ -0,0 +1,178 @@
+/*
+ * VirtualWorld: no-JIT (TCI) execution-memory audit for the HarmonyOS
+ * "VW_ENABLE_QEMU_OHOS_NOJIT" variant of the in-process QEMU core.
+ *
+ * The variant is built with the upstream TCG *interpreter* (--enable-tcg-interpreter),
+ * so no native code generator exists and no executable memory should ever be
+ * requested.  Two independent proofs are provided at run time:
+ *
+ *   vw_nojit_execmem_requests  - incremented by qemu_mprotect_rwx() when the build
+ *                                is configured with -DCONFIG_VW_OHOS_NOJIT.  It is the
+ *                                allocator-level guard: a non-zero value means some
+ *                                component tried to create/switch to executable memory
+ *                                and the acceptance run must fail.
+ *   vw_nojit_count_anon_exec_regions()
+ *                              - walks this process' own Mach VM map and counts
+ *                                *anonymous executable* regions, i.e. memory that was
+ *                                made executable without being backed by the on-disk
+ *                                image (JIT / RWX / RW->RX).  The program text is
+ *                                file-backed and therefore not counted.
+ *
+ * Both must be 0 for the no-JIT gate.  Nothing in this file is compiled unless the
+ * vw_enable_qemu_ohos_nojit option is enabled, so default builds are unchanged.
+ */
+#include "qemu/osdep.h"
+
+#ifdef __APPLE__
+#include <mach/mach.h>
+#include <mach/vm_region.h>
+#include <mach/vm_map.h>
+#endif
+
+unsigned vw_nojit_execmem_requests;
+
+/* Prototypes (this file is compiled into libsystem.a; no public header needed). */
+void vw_nojit_note_execmem(void);
+unsigned vw_nojit_execmem_count(void);
+unsigned vw_nojit_anon_exec_regions(void);
+int vw_nojit_audit_report(const char *tag);
+
+void vw_nojit_note_execmem(void)
+{
+    vw_nojit_execmem_requests++;
+}
+
+unsigned vw_nojit_execmem_count(void)
+{
+    return vw_nojit_execmem_requests;
+}
+
+#ifdef __APPLE__
+static unsigned count_anon_exec_regions(void)
+{
+    mach_port_t task = mach_task_self();
+    vm_address_t addr = 0;
+    unsigned found = 0;
+    vm_size_t size = 0;
+    natural_t depth = 0;
+    vm_region_submap_info_data_64_t info;
+
+    for (;;) {
+        mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+        kern_return_t kr = vm_region_recurse_64(task, &addr, &size, &depth,
+                                                (vm_region_recurse_info_t)&info,
+                                                &count);
+        if (kr != KERN_SUCCESS) {
+            break;
+        }
+        if ((info.protection & VM_PROT_EXECUTE) &&
+            (info.external_pager == 0) && (info.share_mode == SM_PRIVATE)) {
+            found++;
+        }
+        addr += size;
+    }
+    return found;
+}
+#else
+/*
+ * Linux/OHOS audit.  /proc/self/maps is parsed so that the program's own
+ * file-backed RX segments and the kernel-provided [vdso] are separated from
+ * *anonymous executable* memory (JIT / RWX / RW->RX), which is what the no-JIT
+ * variant must never contain.  Anonymous executable mappings are those with the
+ * 'x' permission and either an empty pathname or an [anon:*] / [heap] style
+ * name.  The function returns the number of such mappings (0 is mandatory).
+ */
+#include <stdio.h>
+#include <string.h>
+
+static int maps_line_is_anon_exec(const char *line, int *file_backed,
+                                  int *vdso)
+{
+    const char *p = strchr(line, ' ');
+    const char *path;
+    int is_exec;
+
+    if (!p) {
+        return 0;
+    }
+    /* perms field: rwxp */
+    p = strchr(p + 1, ' ');
+    if (!p) {
+        return 0;
+    }
+    is_exec = (p[2] == 'x' || p[2] == 'X');
+    if (!is_exec) {
+        return 0;
+    }
+    /* The pathname is the last field (may be empty or contain spaces). */
+    path = p + 1;
+    while (*path == ' ') {
+        path++;
+    }
+    if (*path == '\0') {
+        return 1;                       /* anonymous executable */
+    }
+    if (!strncmp(path, "[vdso]", 6) || !strncmp(path, "[vsyscall]", 10)) {
+        (*vdso)++;
+        return 0;
+    }
+    if (path[0] == '[') {
+        return 1;                       /* [anon:...], [heap], [stack], ... */
+    }
+    (*file_backed)++;
+    return 0;
+}
+
+static unsigned count_anon_exec_regions(void)
+{
+    FILE *f = fopen("/proc/self/maps", "r");
+    char line[1024];
+    int file_backed = 0, vdso = 0;
+    unsigned anon = 0, total = 0;
+
+    if (!f) {
+        return 0;
+    }
+    while (fgets(line, sizeof(line), f)) {
+        const char *p = strchr(line, ' ');
+        int is_exec;
+
+        if (!p) {
+            continue;
+        }
+        p = strchr(p + 1, ' ');
+        if (!p) {
+            continue;
+        }
+        is_exec = (p[2] == 'x' || p[2] == 'X');
+        if (is_exec) {
+            total++;
+        }
+        anon += maps_line_is_anon_exec(line, &file_backed, &vdso);
+    }
+    fclose(f);
+    fprintf(stderr, "[nojit] maps: exec_total=%u file_backed_rx=%d anon_exec=%u "
+            "vdso=%d\n", total, file_backed, anon, vdso);
+    return anon;
+}
+#endif
+
+unsigned vw_nojit_anon_exec_regions(void)
+{
+    return count_anon_exec_regions();
+}
+
+int vw_nojit_audit_report(const char *tag)
+{
+    unsigned req = vw_nojit_execmem_count();
+    unsigned anon = vw_nojit_anon_exec_regions();
+
+    fprintf(stderr, "[nojit] %s execmem_requests=%u anon_exec_regions=%u\n",
+            tag ? tag : "-", req, anon);
+    if (req != 0 || anon != 0) {
+        fprintf(stderr, "[nojit] FAIL: executable memory was requested/mapped in "
+                "the no-JIT variant\n");
+        return -1;
+    }
+    return 0;
+}
diff --git a/plugins/core.c b/plugins/core.c
index 1113bfe5673c904bf0e5a50d03fca434a3d7bde7..deea1452031efa4f715160e027a9da72011ff0ea 100644
--- a/plugins/core.c
+++ b/plugins/core.c
@@ -264,6 +264,18 @@ static void qemu_plugin_vcpu_init__async(CPUState *cpu, run_on_cpu_data unused)
     plugin_cpu_update__locked(&cpu->cpu_index, NULL, NULL);
     success = g_hash_table_insert(plugin.cpu_ht, &cpu->cpu_index,
                                   &cpu->cpu_index);
+    if (!success) {
+        /*
+         * VirtualWorld: in-process lifecycle.  plugin.cpu_ht is
+         * process-lifetime and keyed by the integer cpu_index, so the second
+         * qemu_init() in the same PID re-uses the same indices and the insert
+         * collides with the entry left by the previous cycle.  Replace the
+         * stale entry instead of aborting the host.
+         */
+        g_hash_table_remove(plugin.cpu_ht, &cpu->cpu_index);
+        success = g_hash_table_insert(plugin.cpu_ht, &cpu->cpu_index,
+                                      &cpu->cpu_index);
+    }
     g_assert(success);
     plugin_grow_scoreboards__locked(cpu);
     qemu_rec_mutex_unlock(&plugin.lock);
