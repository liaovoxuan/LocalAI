+/* forward declaration of the static inline defined later in this file */
+static inline bool object_property_is_child(ObjectProperty *prop);
+/* helper implemented after the LinkProperty definition further down */
+Object **qemu_inprocess_link_targetp(Object *obj, ObjectProperty *prop);
+static bool qemu_inprocess_prop_is_link(ObjectProperty *prop);
+
+/*
+ * VirtualWorld: sweep stale bus-child link properties on every surviving bus.
+ *
+ * The in-process lifecycle finalizes devices, but the process-lifetime buses
+ * (the main "System" bus and the PCIE root bus) survive the teardown.  If a
+ * device was finalized without bus_remove_child() having removed its
+ * "child[N]" link property (device QOM parent was /machine/peripheral-anon,
+ * /machine/unattached or a container, while parent_bus was the surviving bus;
+ * or a rejected init failed mid-realize), the surviving bus keeps a link
+ * property pointing at freed memory.  Later, releasing that property (bus
+ * finalization / machine graph walk) unrefs a dead pointer -> libmalloc
+ * "pointer being freed was not allocated", SIGSEGV or the rare hang.
+ *
+ * This sweep runs at the end of every in-process teardown (both the normal and
+ * the failed-init path): for every surviving object's "child[N]" link property
+ *   - dead target  -> zero the target pointer first (so the property release
+ *                     cannot unref it), report via error_report, delete the
+ *                     property;
+ *   - live target  -> the device is still on a surviving bus: unparent it
+ *                     (device_unparent -> bus_remove_child removes the bus
+ *                     child and the property) and then delete any leftover.
+ *
+ * Returns the number of repaired stale properties.  The verbose flag controls
+ * the error_report (kept for the teardown call; the validation canary is
+ * silent-except-bad).
+ */
+typedef struct VwStaleProp {
+    Object *obj;      /* object owning the property (ref held) */
+    char *name;
+    Object *target;   /* original (possibly dead) target */
+    bool dead;
+} VwStaleProp;
+
+int qemu_inprocess_sweep_stale_bus_children(int verbose)
+{
+    GPtrArray *work;
+    int repaired = 0;
+    GHashTableIter hit;
+    gpointer key;
+    guint i;
+
+    if (!qemu_inprocess_live_objects) {
+        return 0;
+    }
+    work = g_ptr_array_new_with_free_func(NULL);
+    g_rec_mutex_lock(&qemu_inprocess_live_lock);
+    g_hash_table_iter_init(&hit, qemu_inprocess_live_objects);
+    while (g_hash_table_iter_next(&hit, &key, NULL)) {
+        Object *obj = key;
+        ObjectPropertyIterator iter;
+        ObjectProperty *prop;
+
+        object_property_iter_init(&iter, obj);
+        while ((prop = object_property_iter_next(&iter))) {
+            Object **targetp;
+            VwStaleProp *w;
+
+            if (!prop->name || !g_str_has_prefix(prop->name, "child[")
+                || !qemu_inprocess_prop_is_link(prop)) {
+                continue;
+            }
+            targetp = qemu_inprocess_link_targetp(obj, prop);
+            if (!targetp || !*targetp) {
+                continue;
+            }
+            w = g_new0(VwStaleProp, 1);
+            object_ref(obj);
+            w->obj = obj;
+            w->name = g_strdup(prop->name);
+            w->target = *targetp;
+            w->dead = !qemu_inprocess_object_is_live(w->target);
+            g_ptr_array_add(work, w);
+        }
+    }
+    g_rec_mutex_unlock(&qemu_inprocess_live_lock);
+
+    for (i = 0; i < work->len; i++) {
+        VwStaleProp *w = g_ptr_array_index(work, i);
+        ObjectProperty *prop = object_property_find(w->obj, w->name);
+
+        if (!prop || !qemu_inprocess_prop_is_link(prop)) {
+            goto next;
+        }
+        {
+            Object **targetp = qemu_inprocess_link_targetp(w->obj, prop);
+
+            if (!targetp) {
+                goto next;
+            }
+            if (w->dead) {
+                /* Zero the target first: the property release must not unref it. */
+                *targetp = NULL;
+                object_property_del(w->obj, w->name);
+                repaired++;
+                goto next;
+            }
+        }
+        goto next;
+next:
+        object_unref(w->obj);
+        g_free(w->name);
+        g_free(w);
+    }
+    g_ptr_array_free(work, TRUE);
+    if (repaired && verbose) {
+        error_report("vw: repaired %d stale bus child link(s)", repaired);
+    }
+    return repaired;
+}
