+/*
+ * Watchdog diagnostics: on a hang, dump every thread's PC/LR (Mach), so the
+ * stuck wait can be symbolized from the log without a debugger.
+ *
+ * VW_DUMP_STACKS=1 additionally dumps a *full backtrace* of every thread:
+ * the watchdog sends SIGUSR2 to each thread and the handler below prints the
+ * interrupted PC/LR/SP/FP plus the raw backtrace() frames of that thread.  The
+ * timeout then aborts (dev-only; the shipped binary never runs a child process
+ * and the same code path compiles into it, so the spawn-symbol scan is
+ * unaffected: only in-process Mach/pthread/backtrace APIs are used).
+ */
+int main(void); /* defined below; used only to locate the image base */
+
+/* Current harness phase, reported by the hang dump so a stuck run can be
+ * attributed to one exact operation. */
+static char g_stage[96] = "start";
+
+/*
+ * VirtualWorld dev-only page write guard (VW_GUARD_MS=1).
+ *
+ * Goal: catch the FIRST illegal write into ms->rp_state.rp_sem.mutex (observed:
+ * first 8 bytes replaced by heap-pointer-looking data during the successful init
+ * that follows the 8 failed-init cycles).
+ *
+ * Reliability design (fixes the two defects of the previous version):
+ *  - arm/disarm are idempotent and disarm is called on every init exit path
+ *    (success, structured error, trap early-return) from both system/vl.c and
+ *    the harness, so no page is left read-only.
+ *  - a write in the guarded page but outside the 64-byte watched range is NOT
+ *    allowed by dropping protection.  The faulting store instruction is decoded
+ *    (AArch64 STR/STRB/STRH/STRW/STUR families, unsigned-offset and
+ *    pre/post/unscaled forms), the store is performed by the handler while the
+ *    page is briefly writable, the page is re-protected and the saved PC is
+ *    advanced past the instruction.  Monitoring therefore continues after a
+ *    legitimate same-page write, and a later write into the watched range is
+ *    still caught.  Undecodable same-page stores are reported and the run fails
+ *    (`_exit(99)`); they are never silently allowed.
+ *  - the handler is async-signal-safe in the strict sense: it performs no
+ *    allocation, takes no locks, calls no stdio/backtrace, and only uses write(2)
+ *    (POSIX async-signal-safe), _exit(2) and direct memory accesses.  mprotect(2)
+ *    is a raw syscall and not in the POSIX async-signal-safe list, but it is the
+ *    only way to toggle protection from a handler; this requirement is stated
+ *    explicitly rather than claimed to be "provably safe".
+ *  - VW_GUARD_SELFTEST=1 runs a synthetic test that proves: contiguous
+ *    "same-page legitimate store -> watched-range store" is caught (the first is
+ *    emulated and verified readable, the second triggers GUARD ILLEGAL-WRITE).
+ */
+extern void *qemu_inprocess_migration_rpsem_addr(void);
+
+#define VW_GUARD_QEMU_MUTEX_BYTES 64
+static void *vw_guard_page;
+static size_t vw_guard_len;
+static unsigned char *vw_guard_target;
+static size_t vw_guard_target_len;
+static char vw_guard_stage[48] = "?";
+static long vw_guard_slide;
+static char vw_guard_buf[256];
+static int vw_guard_buf_n;
+
+static int vw_guard_on(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        on = getenv("VW_GUARD_MS") != NULL || getenv("VW_GUARD_SELFTEST");
+    }
+    return on;
+}
+
+static void vw_guard_putstr(const char *t)
+{
+    while (*t && vw_guard_buf_n < (int)sizeof(vw_guard_buf) - 1) {
+        vw_guard_buf[vw_guard_buf_n++] = *t++;
+    }
+}
+
+static void vw_guard_puthex(unsigned long long v)
+{
+    char t[19];
+    int i = 0;
+
+    vw_guard_putstr("0x");
+    do {
+        unsigned d = v & 0xf;
+
+        t[i++] = d < 10 ? '0' + d : 'a' + d - 10;
+        v >>= 4;
+    } while (v && i < 18);
+    while (i-- > 0) {
+        if (vw_guard_buf_n < (int)sizeof(vw_guard_buf) - 1) {
+            vw_guard_buf[vw_guard_buf_n++] = t[i];
+        }
+    }
+}
+
+static void vw_guard_emit(void)
+{
+    if (vw_guard_buf_n > 0) {
+        ssize_t r = write(2, vw_guard_buf, vw_guard_buf_n);
+
+        (void)r;
+    }
+}
+
+static void vw_guard_putregs(unsigned long long x0, unsigned long long x1,
+                             unsigned long long x2, unsigned long long x3)
+{
+    vw_guard_putstr(" x0=");
+    vw_guard_puthex(x0);
+    vw_guard_putstr(" x1=");
+    vw_guard_puthex(x1);
+    vw_guard_putstr(" x2=");
+    vw_guard_puthex(x2);
+    vw_guard_putstr(" x3=");
+    vw_guard_puthex(x3);
+}
+
+/* Protects/unprotects one page.  Idempotent, safe to call on any path. */
+static void vw_guard_protect(int writable)
+{
+    if (!vw_guard_page) {
+        return;
+    }
+    if (mprotect(vw_guard_page, vw_guard_len,
+                 writable ? (PROT_READ | PROT_WRITE) : PROT_READ) != 0) {
+        vw_guard_buf_n = 0;
+        vw_guard_putstr("[guard] MPROTECT-FAILED page=");
+        vw_guard_puthex((unsigned long long)(uintptr_t)vw_guard_page);
+        vw_guard_putstr(" stage=");
+        vw_guard_putstr(vw_guard_stage);
+        vw_guard_putstr("\n");
+        vw_guard_emit();
+        _exit(96);
+    }
+}
+
+void qemu_inprocess_guard_arm(const char *tag)
+{
+    void *mutex;
+    long ps;
+
+    if (!vw_guard_on()) {
+        return;
+    }
+    mutex = qemu_inprocess_migration_rpsem_addr();
+    if (!mutex) {
+        return;
+    }
+    ps = sysconf(_SC_PAGESIZE);
+    vw_guard_target = (unsigned char *)mutex;
+    vw_guard_target_len = VW_GUARD_QEMU_MUTEX_BYTES;
+    vw_guard_page = (void *)((uintptr_t)mutex & ~((uintptr_t)ps - 1));
+    vw_guard_len = (size_t)ps;
+    snprintf(vw_guard_stage, sizeof(vw_guard_stage), "%s", tag);
+    vw_guard_protect(0);
+    if (getenv("VW_TRACE_GUARD")) {
+        fprintf(stderr, "[guard] arm %s page=%p target=%p\n", tag,
+                vw_guard_page, (void *)vw_guard_target);
+    }
+}
+
+void qemu_inprocess_guard_disarm(const char *tag)
+{
+    if (!vw_guard_on() || !vw_guard_page) {
+        return;
+    }
+    vw_guard_protect(1);
+    if (getenv("VW_TRACE_GUARD")) {
+        fprintf(stderr, "[guard] disarm after %s (stage was %s)\n",
+                tag ? tag : "?", vw_guard_stage);
+    }
+}
