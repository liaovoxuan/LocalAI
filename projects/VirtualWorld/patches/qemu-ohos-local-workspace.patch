diff --git a/accel/tcg/tb-maint.c b/accel/tcg/tb-maint.c
index 4313864d2c5d24e30dc1cfbcdf9a81eb7eb0e323..fcb6ab05d8a4da6ccacf51c77344ee27fb0bfe49 100644
--- a/accel/tcg/tb-maint.c
+++ b/accel/tcg/tb-maint.c
@@ -68,8 +68,24 @@ static bool tb_cmp(const void *ap, const void *bp)
 void tb_htable_init(void)
 {
     unsigned int mode = QHT_MODE_AUTO_RESIZE;
+    /*
+     * VirtualWorld: in-process lifecycle.  tb_ctx (and its QHT map) is a
+     * process-lifetime global, but tcg_init_machine() initialises it on every
+     * qemu_init().  Upstream runs exactly one init per process, so it never has
+     * to free the previous map; an embedded QEMU otherwise leaks the complete
+     * TB hash-table bucket array (512 KiB for the default CODE_GEN_HTABLE_SIZE)
+     * on every cycle.  The table is recreated at a point where every vCPU
+     * thread of the previous cycle is gone, so destroying the old map is safe;
+     * stale TB pointers of the retired cycle must be dropped anyway because the
+     * code generation region is reused from the start.
+     */
+    static bool tb_htable_initialised;
 
+    if (tb_htable_initialised) {
+        qht_destroy(&tb_ctx.htable);
+    }
     qht_init(&tb_ctx.htable, tb_cmp, CODE_GEN_HTABLE_SIZE, mode);
+    tb_htable_initialised = true;
 }
 
