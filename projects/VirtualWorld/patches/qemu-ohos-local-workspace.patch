+/*
+ * VirtualWorld: dev-only integrity probe for the process-lifetime migration
+ * state (armed by VW_TRACE_MIG).  The intermittent in-process teardown failure
+ * aborts inside migration_instance_finalize()/migration_incoming_state_release()
+ * destroying a qemu_mutex/qemu_sem whose ->initialized flag is false, i.e. the
+ * MigrationState/MigrationIncomingState memory was already corrupted before
+ * qemu_cleanup().  Printing the flags at init-return and at cleanup-entry tells
+ * when that happened.  No effect unless the env var is set.
+ */
+/*
+ * VirtualWorld: watch ms->rp_state.rp_sem.mutex.initialized.  In the failing
+ * runs it is already 48 (invalid) at init-return/cleanup-entry, i.e. the
+ * process-lifetime MigrationState memory was overwritten rather than destroyed
+ * twice.  The harness calls this probe at every lifecycle stage; the first
+ * stage where the value deviates from 1 is reported once with a raw byte dump
+ * and a backtrace of the probe call site.
+ */
+/* Address of the watched mutex (NULL when no MigrationState exists). */
+void *qemu_inprocess_migration_rpsem_addr(void)
+{
+    MigrationState *ms = current_migration;
+
+    return ms ? (void *)&ms->rp_state.rp_sem.mutex : NULL;
+}
+
+static unsigned char vw_rpsem_shadow[64];
+static void *vw_rpsem_shadow_addr;
+static int vw_rpsem_shadow_valid;
+static int vw_rpsem_mutation_reported;
+
+void qemu_inprocess_migration_rpsem_shadow_reset(void)
+{
+    MigrationState *ms = current_migration;
+    QemuMutex *m;
+
+    if (!ms) {
+        vw_rpsem_shadow_valid = 0;
+        return;
+    }
+    m = &ms->rp_state.rp_sem.mutex;
+    vw_rpsem_shadow_addr = (void *)m;
+    memcpy(vw_rpsem_shadow, m, sizeof(vw_rpsem_shadow));
+    vw_rpsem_shadow_valid = 1;
+    vw_rpsem_mutation_reported = 0;
+}
+
+void qemu_inprocess_migration_rpsem_probe(const char *tag)
+{
+    static int trace = -1;
+    static void *watch_addr;
+    static int reported;
+    MigrationState *ms = current_migration;
+
+    if (trace < 0) {
+        trace = getenv("VW_TRACE_RPSEM") != NULL;
+    }
+    if (!trace) {
+        return;
+    }
+    if (!ms) {
+        fprintf(stderr, "[rpsem] %-28s ms=NULL\n", tag ? tag : "?");
+        return;
+    }
+    {
+        QemuMutex *m = &ms->rp_state.rp_sem.mutex;
+        const unsigned char *b = (const unsigned char *)m;
+        char hex[80];
+        int i, k = 0;
+
+        if (!watch_addr) {
+            watch_addr = (void *)m;
+        }
+        for (i = 0; i < 16; i++) {
+            k += snprintf(hex + k, sizeof(hex) - k, "%02x", b[i]);
+        }
+        fprintf(stderr, "[rpsem] %-28s ms=%p addr=%p init=%d bytes=%s\n",
+                tag ? tag : "?", (void *)ms, (void *)m,
+                (int)m->initialized, hex);
+        if (vw_rpsem_shadow_valid && vw_rpsem_shadow_addr == (void *)m &&
+            !vw_rpsem_mutation_reported) {
+            int off;
+
+            for (off = 0; off < (int)sizeof(vw_rpsem_shadow); off++) {
+                if (((const unsigned char *)m)[off] != vw_rpsem_shadow[off]) {
+                    vw_rpsem_mutation_reported = 1;
+                    fprintf(stderr, "[rpsem] BYTE-MUTATION-FIRST stage=%s "
+                            "offset=%d old=%02x new=%02x\n",
+                            tag ? tag : "?", off, vw_rpsem_shadow[off],
+                            ((const unsigned char *)m)[off]);
+#ifdef __APPLE__
+                    {
+                        void *bt[24];
+                        int n = backtrace(bt, 24);
+
+                        fprintf(stderr, "[rpsem] mutation probe backtrace:\n");
+                        backtrace_symbols_fd(bt, n, 2);
+                    }
+#endif
+                    break;
+                }
+            }
+        }
+        if (watch_addr == (void *)m && m->initialized != 1 && !reported) {
+            reported = 1;
+            fprintf(stderr, "[rpsem] FIRST ANOMALY stage=%s init=%d "
+                    "(expected 1) watch=%p\n", tag ? tag : "?",
+                    (int)m->initialized, watch_addr);
+#ifdef __APPLE__
+            {
+                void *bt[20];
+                int n = backtrace(bt, 20);
+
+                fprintf(stderr, "[rpsem] probe-call backtrace:\n");
+                backtrace_symbols_fd(bt, n, 2);
+            }
+#endif
+        }
+    }
+}
+
+void qemu_inprocess_migration_state_check(const char *tag)
+{
+    MigrationState *ms = current_migration;
+    MigrationIncomingState *mis = current_incoming;
