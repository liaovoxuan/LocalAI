+ * doing so keeps the ordering explicit and prevents use-after-free inside the
+ * walk.  The caller flushes the queued RCU callbacks afterwards.
+ */
+static int qemu_inprocess_teardown_collect_cb(Object *child, void *opaque)
+{
+    g_ptr_array_add(opaque, object_ref(child));
+    return 0;
+}
+
+static void qemu_inprocess_teardown_tree(Object *obj)
+{
+    GPtrArray *kids = g_ptr_array_new();
+    guint i;
+
+    object_child_foreach(obj, qemu_inprocess_teardown_collect_cb, kids);
+    for (i = 0; i < kids->len; i++) {
+        qemu_inprocess_teardown_tree(g_ptr_array_index(kids, i));
+    }
+    for (i = 0; i < kids->len; i++) {
+        Object *kid = g_ptr_array_index(kids, i);
+        const char *tn = object_get_typename(kid);
+
+        object_unparent(kid);
+        if (qemu_inprocess_object_refcount(kid) == 0) {
+            fprintf(stderr, "[teardown] %s finalized by its own unparent\n",
+                    tn);
+            continue;
+        }
+        object_unref(kid);
+    }
+    g_ptr_array_free(kids, TRUE);
+}
+
+static int qemu_inprocess_collect_mrs_cb(Object *obj, void *opaque)
+{
+    if (object_dynamic_cast(obj, TYPE_MEMORY_REGION)) {
+        g_ptr_array_add(opaque, obj);
+    }
+    return 0;
+}
+
+static int qemu_inprocess_collect_devs_cb(Object *obj, void *opaque)
+{
+    if (object_dynamic_cast(obj, TYPE_DEVICE)) {
+        g_ptr_array_add(opaque, obj);
+    }
+    return 0;
+}
+
+/* hw/pci/pci.c: drop the process-lifetime registry of PCI root buses. */
+void pci_inprocess_reset_host_bridges(void);
+
+/*
+ * VirtualWorld: dev-only teardown phase diagnostics (VW_TRACE_TEARDOWN).
+ * Prints, at every teardown phase, the per-CPU lifecycle state and the RCU
+ * queue depth (the in-process-only thread-PC/TCG classification helpers are
+ * used by the harness watchdog and are not referenced from QEMU core code, so
+ * a stock build of this tree links unchanged).
+ */
+extern int qemu_inprocess_rcu_pending(void);
+extern int qemu_inprocess_object_validate_all(const char *tag);
+extern int qemu_inprocess_sweep_stale_bus_children(int verbose);
+extern void qemu_inprocess_migration_state_check(const char *tag);
+
+static void vw_teardown_diag(const char *phase);
+
+/*
+ * VirtualWorld: RCU quiescence barrier for the in-process teardown.
+ *
+ * drain_call_rcu() guarantees that callbacks queued (from this thread) before
+ * the drain node have run; a chained callback queued by the RCU helper thread
+ * itself while it executes an earlier callback can therefore still be pending
+ * when drain_call_rcu() returns.  The machine tree may only be finalized when
+ * NO deferred finalizer is left that could unref a device/memory-region it
+ * contains (the "bus_free_bus_child unrefs a device the teardown already
+ * finalized" class).  Drain until the queue is observed empty (bounded), and
+ * report if it never drains instead of silently continuing.
+ */
+static void vw_rcu_quiesce(const char *tag)
+{
+    int i;
+
+    for (i = 0; i < 16; i++) {
+        drain_call_rcu();
+        if (!qemu_inprocess_rcu_pending || qemu_inprocess_rcu_pending() == 0) {
+            if (getenv("VW_TRACE_TEARDOWN")) {
+                fprintf(stderr, "[teardown] rcu-quiesce %s done after %d "
+                        "drain(s)\n", tag, i + 1);
+            }
+            return;
+        }
+    }
+    error_report("vw: RCU queue still has %d pending callback(s) at teardown "
+                 "phase %s after 16 drains (host state may be corrupt)",
+                 qemu_inprocess_rcu_pending ? qemu_inprocess_rcu_pending() : -1,
+                 tag);
+}
+
+static void vw_teardown_diag(const char *phase)
+{
+    CPUState *cpu;
+    int ncpu = 0;
+
+    if (!getenv("VW_TRACE_TEARDOWN")) {
+        return;
+    }
+    fprintf(stderr, "[teardown] phase=%s\n", phase);
+    CPU_FOREACH(cpu) {
+        ncpu++;
+        fprintf(stderr, "[teardown] %s cpu%d created=%d stop=%d unplug=%d "
+                "realized=%d\n", phase, cpu->cpu_index, (int)cpu->created,
+                (int)cpu->stop, (int)cpu->unplug,
+                (int)DEVICE(cpu)->realized);
+    }
+    fprintf(stderr, "[teardown] %s cpus=%d rcu_pending=%d\n", phase, ncpu,
+            qemu_inprocess_rcu_pending ? qemu_inprocess_rcu_pending() : -1);
+    if (getenv("VW_OBJ_CANARY_PHASES")) {
+        int bad = qemu_inprocess_object_validate_all(phase);
+
+        if (bad && getenv("VW_OBJ_CANARY_ABORT")) {
+            fprintf(stderr, "[objcanary] %s: aborting on first corruption "
+                    "(%d bad property/ies)\n", phase, bad);
+            abort();
+        }
+    }
+    if (getenv("VW_TRACE_MIG")) {
+        qemu_inprocess_migration_state_check(phase);
+    }
+}
+
+void qemu_inprocess_cycle_teardown(void)
+{
+    CPUState *cpu;
+    Object *machine;
+
+    vw_teardown_diag("entry");
+
+    /*
+     * On hosts without a native signalfd, qemu_init_main_loop() started a
+     * *detached* sigwait() helper thread (plus a pipe) through
+     * qemu_signalfd_compat(); upstream lets process exit reap it, which leaks
+     * one thread + one pipe per in-process cycle and eventually exhausts the
+     * host thread limit.  Stop and join it before the next cycle.
+     */
+    qemu_signalfd_compat_cleanup();
+    vw_teardown_diag("after-signalfd");
+
+    /* Bus children must not outlive the devices they point at (see qdev.c). */
+    qdev_set_inprocess_teardown(true);
+    /* Keep guest RAM mappings resident and reusable across cycles. */
+    qemu_inprocess_keep_ram = true;
+
+    /*
+     * Stop the vCPU threads, then take the CPUs out of service the same way
+     * hot-unplug does: qdev_unrealize() -> cpu_common_unrealizefn() ->
+     * cpu_exec_unrealizefn() removes the CPU from the process-lifetime cpu_list
+     * and destroys its AddressSpaces.  Without it the next cycle's
+     * qemu_get_cpu() returns a finalized CPU (observed: machvirt_init ->
+     * gic_connect_ppis -> "Property 'cortex-a15-arm-cpu.unnamed-gpio-out[0]'
+     * not found") and the CPU AddressSpaces leak into the flatview graph.
+     */
+    CPU_FOREACH(cpu) {
+        if (cpu->created) {
+            cpu_remove_sync(cpu);
+        }
+        if (DEVICE(cpu)->realized) {
+            qdev_unrealize(DEVICE(cpu));
+        }
+    }
+
+    vw_teardown_diag("after-vcpu-stop");
+    if (!current_machine) {
+        /* A failed init can leave deferred finalizers behind; flush them before
+         * the next init runs (H3: no callback may outlive its owner). */
+        vw_rcu_quiesce("no-machine");
+        qemu_inprocess_sweep_stale_bus_children(0);
+        qdev_set_inprocess_teardown(false);
+        return;
+    }
+
+    /*
+     * Drop the per-cycle callbacks *before* any object of the tree can be
+     * freed: the machine-init-done registrations are embedded in devices/buses
+     * and the resettable registrations in devices, so walking those lists after
+     * the tree is torn down would dereference freed objects (ASan:
+     * heap-use-after-free in qemu_inprocess_retire_machine_notifiers).
+     */
+    qemu_inprocess_retire_machine_notifiers();
+    qemu_inprocess_retire_resettables();
+    vw_teardown_diag("after-retire-registries");
+    machine = OBJECT(current_machine);
+
+    /*
+     * Release the per-cycle memory wiring and the memory-container -> owner
+     * references, and clear every subregion's ->container so the next cycle can
+     * re-populate the process-lifetime system memory containers.
+     */
+    if (getenv("VW_TRACE_MEM")) {
+        machine_memory_report();
+    }
+    machine_memory_cleanup();
+    vw_teardown_diag("after-machine-memory-cleanup");
+
+    /*
+     * accel_init_machine() keeps the accelerator in ms->accelerator and leaves
+     * the creator's reference there (upstream relies on process exit), so the
+     * accelerator object would survive the machine finalization: one leaked
+     * object per cycle.
+     */
+    /*
+     * The machine's device tree blob (ms->fdt, built by the board) is never
+     * freed upstream (process exit reclaims it); it is ~100-200 KiB per cycle.
+     */
+    if (MACHINE(machine)->fdt) {
+        g_free(MACHINE(machine)->fdt);
+        MACHINE(machine)->fdt = NULL;
+    }
+
+    if (MACHINE(machine)->accelerator) {
+        object_unref(OBJECT(MACHINE(machine)->accelerator));
+        MACHINE(machine)->accelerator = NULL;
+    }
+
+    /*
+     * Every MemoryRegion owned by the machine tree must leave its container:
+     * a container holds a reference on the subregion's *owner*, so a single
+     * region that is still attached somewhere keeps the whole machine object
+     * alive (observed: the machine survived qemu_inprocess_cycle_teardown()
+     * with ref==1 forever, i.e. one leaked machine per cycle).
+     */
+    {
+        GPtrArray *mrs = g_ptr_array_new();
+        guint i;
+
+        object_child_foreach_recursive(machine,
+                                       qemu_inprocess_collect_mrs_cb, mrs);
+        for (i = mrs->len; i > 0; i--) {
+            memory_region_del_all_subregions(g_ptr_array_index(mrs, i - 1));
+        }
+        for (i = mrs->len; i > 0; i--) {
+            memory_region_disconnect(g_ptr_array_index(mrs, i - 1));
+        }
+        g_ptr_array_free(mrs, TRUE);
+    }
+
+    /*
+     * Removing subregions/address spaces retires FlatViews through call_rcu().
+     * flatview_destroy() frees the sections (and with them memory-region
+     * references) and then unrefs view->ranges[i].mr: it must run while every
+     * memory region is still alive.  Flush the deferred destruction now, before
+     * the machine tree is finalized, or the RCU thread dereferences freed
+     * memory-region objects (ASan: heap-use-after-free in
+     * memory_region_unref <- flatview_destroy <- call_rcu_thread).
+     */
+    drain_call_rcu();
+
+    /*
+     * A *failed* init (this teardown also runs from the checked-init failure
+     * path) leaves the objects and chardevs it created behind in the
+     * process-lifetime root containers; the next init would then reject an
+     * otherwise valid configuration ("object's id 'mach-virt.ram' is reserved
+     * for the default RAM backend").  Mirror the cleanup qemu_cleanup() does,
+     * then restore the containers.
+     */
+    user_creatable_cleanup();
+    qemu_chr_cleanup();
+    object_root_ensure_containers();
+
+    /*
+     * Forget the vmstate registrations of the cycle being retired: they live in
+     * the process-lifetime savevm handler list, and a stale compat entry makes
+     * the next cycle's registration compute a non-zero instance id and assert
+     * (see savevm_state_reset()).
+     */
+    savevm_state_reset();
+    /* -global entries borrow strings from the options, so drop them first. */
+    qemu_inprocess_reset_global_props();
+    /* Drop the previous cycle's parsed options (see qemu_inprocess_reset_opts). */
+    qemu_inprocess_reset_opts();
+    /* ROM registration is process-lifetime too (roms_loaded / roms list). */
+    rom_release_all();
+    /*
+     * The retired machine's machine-init-done notifier must not run again for
+     * the next machine (it would rebuild FDT nodes in the retired tree).
+     */
+    /* Retired devices must not be reset by the next cycle. */
+
+    /*
+     * Tear the machine down for real: no object of the retired cycle may
+     * survive a completed create/init/run/stop/cleanup/destroy cycle.
+     *
+     * QOM finalizes an object's children before its own instance_finalize(), in
+     * hash-table order, and device finalization is deferred through call_rcu().
+     * Unparenting the tree naively therefore reproduces several lifetime bugs
+     * (devices finalized in creation order, GPIO links released after their
+     * target storage was freed, children freed before the parent's finalize
+     * method dereferences them).  The ordering below mirrors what a correct
+     * teardown needs:
+     *   1. release every device's output GPIO link properties (their targetp
+     *      points into device state that unrealize() frees);
+     *   2. unparent the children of every bus, newest first, so devices leave
+     *      their buses in reverse creation order;
+     *   3. detach the machine from /machine: this finalizes the remaining tree;
+     *   4. flush the RCU-deferred finalizers with the BQL dropped.
+     */
+    {
+        GPtrArray *devs = g_ptr_array_new();
+        guint i;
+
+        object_child_foreach_recursive(machine, qemu_inprocess_collect_devs_cb,
+                                       devs);
+        /*
+         * Unrealize every device, newest first, before anything is finalized.
+         *
+         * Several devices embed an AddressSpace (PCIDevice.bus_master_as,
+         * PCIBridge.as_mem/as_io, virtio-pci modern_cfg_*, ...) and queue it as
+         * the rcu_head of address_space_destroy().  Upstream can do that because
+         * the process exits; here the device must stay alive until the callback
+         * ran, so unrealize (which queues those callbacks) happens while the
+         * whole tree is still alive, and the queue is drained before the tree is
+         * finalized.  Otherwise call_rcu_thread() reads a zeroed node
+         * (node->func == NULL) out of freed device memory.
+         */
+        /* Release GPIO link properties first: their targetp points into device
+         * state that unrealize() frees (gpex-pcihost/EHCI free their irq
+         * arrays there). */
+        for (i = devs->len; i > 0; i--) {
+            qdev_disconnect_all_gpio_out(g_ptr_array_index(devs, i - 1));
+        }
+        for (i = devs->len; i > 0; i--) {
+            DeviceState *dev = g_ptr_array_index(devs, i - 1);
+            if (dev->realized) {
+                qdev_unrealize(dev);
+            }
+        }
+        drain_call_rcu();
+        g_ptr_array_free(devs, TRUE);
+    }
+    drain_call_rcu();
+
+    /*
+     * Do not walk the tree by hand here: QOM unparents children itself when the
+     * machine finalizes.  The ordering hazards are handled before this point
+     * (GPIO link properties released, memory-region owner references dropped,
+     * bus children freed synchronously), so plain finalization is safe.
+     */
+
+    /*
+     * Removing a device from its bus frees the bus-child bookkeeping through
+     * call_rcu(); that callback (bus_free_bus_child) unrefs the device object,
+     * so it must run before the devices are finalized below (otherwise it
+     * unrefs freed memory: "object_unref: assertion failed: (obj->ref > 0)").
+     */
+    drain_call_rcu();
+
+    vw_teardown_diag("before-object-unparent");
+    /* No deferred finalizer may fire while the tree is being freed. */
+    vw_rcu_quiesce("before-finalize");
+    /* The process-lifetime PCI root-bus registry points into this tree. */
+    pci_inprocess_reset_host_bridges();
+
+    current_machine = NULL;
+    qdev_machine_forget();
+
+    object_unparent(machine);
+    /*
+     * qemu_create_machine() returns a reference that upstream never releases
+     * (the process exits).  Drop it, so the machine finalizes now: the
+     * child-property reference was released by object_unparent() above and all
+     * memory-region owner references by the sweep before it.
+     */
+    object_unref(machine);
+    vw_teardown_diag("after-machine-unref");
+    /* call_rcu() finalizers take the BQL, so it must be dropped here. */
+    drain_call_rcu();
+    vw_teardown_diag("after-final-drain");
+    /* Flush chained callbacks queued by the RCU thread during the finalize. */
+    vw_rcu_quiesce("after-finalize");
+    /* Surving (process-lifetime) buses must not keep link properties to
+     * devices that this teardown finalized/freed. */
+    qemu_inprocess_sweep_stale_bus_children(getenv("VW_TRACE_TEARDOWN") != NULL);
+    qdev_set_inprocess_teardown(false);
+}
