diff --git a/qemu-inprocess/alloc_trace.c b/qemu-inprocess/alloc_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..283b5596cbb8c1a6595ca2ea4bc692bf6de0c31f
--- /dev/null
+++ b/qemu-inprocess/alloc_trace.c
@@ -0,0 +1,486 @@
+/*
+ * alloc_trace.c - diagnostic allocation attribution for the in-process QEMU
+ * lifecycle (VW_TRACE_ALLOC).
+ *
+ * Why this exists: the lifecycle teardown is proven to leave ~605 KiB of plain
+ * glib/malloc heap behind per cycle (macOS default malloc zone size_in_use
+ * grows by exactly that much while QOM objects, guest RAM mappings and
+ * RAMBlocks stay flat).  MallocStackLogging / malloc_history are not usable on
+ * this host ("target process has no stack logs"), so we install our own
+ * libmalloc hook.
+ *
+ * libsystem_malloc exports a public data symbol, `malloc_logger`.  When set,
+ * libmalloc calls it for every allocation/deallocation:
+ *
+ *   allocate : type | MALLOC_LOG_TYPE_ALLOCATE (2),  (HAS_ZONE ? arg1=zone :
+ *              arg1=size), (HAS_ZONE ? arg2=size : arg2=0), result=pointer
+ *   dealloc  : type | MALLOC_LOG_TYPE_DEALLOCATE (4), (HAS_ZONE ? arg2=pointer
+ *              : arg1=pointer)
+ *
+ * We keep a live-allocation hash table (pointer -> size, allocation site) and a
+ * table of allocation sites (captured with backtrace()).  alloc_trace_step()
+ * snapshots the live bytes per site; alloc_trace_report() diffs that snapshot
+ * against the live bytes after the lifecycle teardown: every site with a
+ * positive delta is memory that the cycle's init allocated and the teardown
+ * never freed.
+ *
+ * The tracker itself must not allocate through malloc (it would recurse), so
+ * both tables are anonymous mmap'd once, and all printing happens with the
+ * hook suppressed by the per-thread busy slot.
+ *
+ * Diagnostic only: everything here is behind VW_TRACE_ALLOC=1 in the harness
+ * and has no effect on the acceptance path.
+ *
+ * License: part of the QEMU distribution, GPLv2 (see qemu-source/COPYING).
+ */
+#if defined(__APPLE__)
+
+#define _DARWIN_C_SOURCE
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "alloc_trace.h"
+
+#define AT_PTR_BITS  21                     /* 2 Mi entries * 16 B = 32 MiB */
+#define AT_PTR_N     (1u << AT_PTR_BITS)
+#define AT_PTR_MASK  (AT_PTR_N - 1u)
+#define AT_STK_BITS  17                     /* 128 Ki sites * ~112 B     */
+#define AT_STK_N     (1u << AT_STK_BITS)
+#define AT_STK_MASK  (AT_STK_N - 1u)
+#define AT_FRAMES    10
+#define AT_TOP       24
+
+typedef struct ATEntry {
+    uintptr_t ptr;      /* 0 = empty, 1 = tombstone */
+    uint32_t size;
+    uint32_t stk;
+} ATEntry;
+
+typedef struct ATStack {
+    uintptr_t frames[AT_FRAMES];
+    uint64_t bytes;     /* live bytes allocated from this site */
+    uint64_t count;     /* live allocations from this site */
+} ATStack;
+
+typedef void (*malloc_logger_t)(uint32_t type, uintptr_t arg1, uintptr_t arg2,
+                                uintptr_t arg3, uintptr_t result,
+                                uint32_t num_hot_frames_to_skip);
+extern malloc_logger_t malloc_logger;
+
+#define MALLOC_LOG_TYPE_ALLOCATE   2u
+#define MALLOC_LOG_TYPE_DEALLOCATE 4u
+
+/*
+ * Argument convention on this libsystem_malloc (measured, not assumed):
+ *
+ *   type=10  (ALLOCATE)               arg1 = zone, arg2 = size,  result = ptr
+ *   type=74  (ALLOCATE|CLEARED)       arg1 = zone, arg2 = size,  result = ptr
+ *   type=12  (DEALLOCATE)             arg1 = zone, arg2 = ptr
+ *   type=14  (ALLOCATE|DEALLOCATE)    realloc: arg1 = zone, arg2 = old ptr,
+ *                                     result = new ptr (a following type=12
+ *                                     frees the old pointer as well)
+ *
+ * Heap pointers are always >= 4 GiB on this platform, while a single malloc
+ * size here never is, so arg1 is classified by range.  (The public HAS_ZONE
+ * flag bit is not the one this libmalloc sets, hence the range check.)
+ */
+#define AT_PTR_MIN 0x100000000ULL
+
+static inline int at_is_heap_ptr(uintptr_t v)
+{
+    return v >= (uintptr_t)AT_PTR_MIN;
+}
+
+static ATEntry *at_ptr;            /* CACHELINE-ALIGNED anonymous mmap */
+static ATStack *at_stk;
+static uint64_t *at_snap;          /* per-site live bytes at last step() */
+static malloc_logger_t at_prev_logger;
+static int at_enabled;
+static uint32_t at_stk_used;
+
+/*
+ * Re-entrancy guard: libmalloc calls malloc_logger *after* the allocation, and
+ * the callback may not use C thread-local storage (__thread access crashes in
+ * _tlv_get_addr in that context -- the allocation that brings TLV in is itself
+ * logged).  pthread_self() is safe there, so the guard is a small array of
+ * per-thread busy slots keyed by it.
+ */
+#define AT_THREADS 64
+static volatile int at_busy[AT_THREADS];
+
+static int at_enter(void)
+{
+    uintptr_t id = (uintptr_t)pthread_self();
+    unsigned h = (unsigned)((id >> 4) % AT_THREADS);
+
+    if (__atomic_exchange_n(&at_busy[h], 1, __ATOMIC_ACQUIRE)) {
+        return 0;
+    }
+    return (int)h + 1;
+}
+
+static void at_leave(int slot)
+{
+    __atomic_store_n(&at_busy[slot - 1], 0, __ATOMIC_RELEASE);
+}
+
+static int at_lock;                /* global spinlock, static storage only */
+
+static uint64_t at_live_bytes;     /* informational: live bytes we track */
+static uint64_t at_live_count;
+static uint64_t at_bad_free, at_bad_alloc, at_double_alloc;
+static uint64_t at_odd_types, at_big_allocs;
+
+static uint64_t at_hash(uint64_t x)
+{
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+    return x;
+}
+
+static int at_stk_find(const uintptr_t *frames, int match_or_create)
+{
+    uint64_t h = 0;
+    uint32_t i;
+    int f;
+
+    for (f = 0; f < AT_FRAMES; f++) {
+        h = at_hash(h ^ frames[f]);
+    }
+    i = (uint32_t)h & AT_STK_MASK;
+    for (uint32_t probe = 0; probe < AT_STK_N; probe++) {
+        ATStack *s = &at_stk[i];
+        if (s->count == 0 && s->bytes == 0 && s->frames[0] == 0) {
+            if (!match_or_create) {
+                return -1;
+            }
+            if (at_stk_used >= AT_STK_N) {
+                return -1;
+            }
+            memset(s, 0, sizeof(*s));
+            memcpy(s->frames, frames, sizeof(s->frames));
+            at_stk_used++;
+            return (int)i;
+        }
+        if (memcmp(s->frames, frames, sizeof(s->frames)) == 0) {
+            return (int)i;
+        }
+        i = (i + 1) & AT_STK_MASK;
+    }
+    return -1;
+}
+
+static void at_on_alloc(uintptr_t ptr, uint32_t size)
+{
+    uintptr_t frames[AT_FRAMES];
+    int n, stk;
+    uint32_t i;
+
+    if (ptr == 0 || size == 0) {
+        return;
+    }
+    n = backtrace((void **)frames, AT_FRAMES);
+    if (n <= 0) {
+        return;
+    }
+    /* Drop this hook's own frame. */
+    if (n > 1) {
+        memmove(frames, frames + 1, (n - 1) * sizeof(frames[0]));
+        n--;
+    }
+    for (int f = n; f < AT_FRAMES; f++) {
+        frames[f] = 0;
+    }
+    stk = at_stk_find(frames, 1);
+    if (stk < 0) {
+        return;
+    }
+
+    i = (uint32_t)at_hash((uint64_t)(ptr >> 4)) & AT_PTR_MASK;
+    for (uint32_t probe = 0; probe < AT_PTR_N; probe++) {
+        ATEntry *e = &at_ptr[i];
+        if (e->ptr == 0 || e->ptr == 1) {
+            e->ptr = ptr;
+            e->size = size;
+            e->stk = (uint32_t)stk;
+            at_stk[stk].bytes += size;
+            at_stk[stk].count++;
+            at_live_bytes += size;
+            at_live_count++;
+            return;
+        }
+        if (e->ptr == ptr) {
+            /* realloc/new-with-same-address: move the accounting */
+            if (at_stk[e->stk].bytes < e->size || at_stk[e->stk].count == 0) {
+                at_bad_alloc++;
+            } else {
+                at_stk[e->stk].bytes -= e->size;
+                at_stk[e->stk].count--;
+            }
+            at_stk[stk].bytes += size;
+            at_stk[stk].count++;
+            at_live_bytes += (uint64_t)size - e->size;
+            e->size = size;
+            e->stk = (uint32_t)stk;
+            return;
+        }
+        i = (i + 1) & AT_PTR_MASK;
+    }
+}
+
+static void at_on_free(uintptr_t ptr)
+{
+    uint32_t i;
+
+    if (ptr == 0) {
+        return;
+    }
+    i = (uint32_t)at_hash((uint64_t)(ptr >> 4)) & AT_PTR_MASK;
+    for (uint32_t probe = 0; probe < AT_PTR_N; probe++) {
+        ATEntry *e = &at_ptr[i];
+        if (e->ptr == 0) {
+            return;
+        }
+        if (e->ptr == ptr) {
+            ATStack *s = &at_stk[e->stk];
+            if (s->bytes < e->size || s->count == 0) {
+                at_bad_free++;
+            } else {
+                s->bytes -= e->size;
+                s->count--;
+                at_live_bytes -= e->size;
+                at_live_count--;
+            }
+            e->ptr = 1; /* tombstone */
+            return;
+        }
+        i = (i + 1) & AT_PTR_MASK;
+    }
+}
+
+static void at_logger(uint32_t type, uintptr_t arg1, uintptr_t arg2,
+                      uintptr_t arg3, uintptr_t result,
+                      uint32_t num_hot_frames_to_skip)
+{
+    int slot;
+
+    (void)arg3;
+    (void)num_hot_frames_to_skip;
+    if (!at_enabled) {
+        return;
+    }
+    slot = at_enter();
+    if (!slot) {
+        return;
+    }
+    /* A single global spinlock: lifecycle allocates from several threads
+     * (main loop, vCPU, RCU).  Diagnostic runs only, contention is fine. */
+    while (__atomic_exchange_n(&at_lock, 1, __ATOMIC_ACQUIRE)) {
+        while (__atomic_load_n(&at_lock, __ATOMIC_RELAXED)) {
+        }
+    }
+    if (type & MALLOC_LOG_TYPE_ALLOCATE) {
+        if (type & MALLOC_LOG_TYPE_DEALLOCATE) {
+            /* realloc: retire the old block; the new one is intentionally left
+             * untracked (its size is not in the event, and the following
+             * deallocate event removes the old accounting anyway). */
+            if (at_is_heap_ptr(arg2)) {
+                at_on_free(arg2);
+            }
+        } else {
+            uintptr_t size = at_is_heap_ptr(arg1) ? arg2 : arg1;
+            if (at_is_heap_ptr(size)) {
+                size = arg2;
+            }
+            if (size != 0) {
+                at_on_alloc(result, (uint32_t)size);
+            }
+        }
+    } else if (type & MALLOC_LOG_TYPE_DEALLOCATE) {
+        uintptr_t p = at_is_heap_ptr(arg2) ? arg2 : arg1;
+        at_on_free(p);
+    }
+    __atomic_store_n(&at_lock, 0, __ATOMIC_RELEASE);
+    at_leave(slot);
+}
+
+int alloc_trace_start(void)
+{
+    size_t ptr_sz = (size_t)AT_PTR_N * sizeof(ATEntry);
+    size_t stk_sz = (size_t)AT_STK_N * sizeof(ATStack);
+    size_t snap_sz = (size_t)AT_STK_N * sizeof(uint64_t);
+
+    if (at_enabled) {
+        return 1;
+    }
+    at_ptr = mmap(NULL, ptr_sz, PROT_READ | PROT_WRITE,
+                  MAP_ANON | MAP_PRIVATE, -1, 0);
+    at_stk = mmap(NULL, stk_sz, PROT_READ | PROT_WRITE,
+                  MAP_ANON | MAP_PRIVATE, -1, 0);
+    at_snap = mmap(NULL, snap_sz, PROT_READ | PROT_WRITE,
+                   MAP_ANON | MAP_PRIVATE, -1, 0);
+    if (at_ptr == MAP_FAILED || at_stk == MAP_FAILED || at_snap == MAP_FAILED) {
+        fprintf(stderr, "[alloc] could not allocate tracker tables\n");
+        return 0;
+    }
+    at_enabled = 1;
+    at_prev_logger = malloc_logger;
+    malloc_logger = at_logger;
+    fprintf(stderr, "[alloc] tracker armed (ptr entries=%u, sites=%u, "
+            "frames=%d)\n", AT_PTR_N, AT_STK_N, AT_FRAMES);
+    return 1;
+}
+
+static void at_snapshot(void)
+{
+    if (!at_enabled) {
+        return;
+    }
+    for (uint32_t i = 0; i < AT_STK_N; i++) {
+        at_snap[i] = at_stk[i].bytes;
+    }
+}
+
+void alloc_trace_step(void)
+{
+    if (!at_enabled) {
+        return;
+    }
+    int slot = at_enter();
+
+    at_snapshot();
+    if (slot) {
+        at_leave(slot);
+    }
+}
+
+static void at_print_frame(int idx, uintptr_t addr)
+{
+    Dl_info info;
+
+    if (addr == 0) {
+        return;
+    }
+    if (dladdr((void *)addr, &info) && info.dli_fname) {
+        const char *base = strrchr(info.dli_fname, '/');
+        base = base ? base + 1 : info.dli_fname;
+        if (info.dli_sname) {
+            fprintf(stderr,
+                    "[alloc]     #%d %s+0x%lx (%s+0x%lx) fbase=%p addr=%p\n",
+                    idx, base,
+                    (unsigned long)(addr - (uintptr_t)info.dli_fbase),
+                    info.dli_sname,
+                    (unsigned long)(addr - (uintptr_t)info.dli_saddr),
+                    info.dli_fbase, (void *)addr);
+        } else {
+            fprintf(stderr, "[alloc]     #%d %s+0x%lx fbase=%p addr=%p\n",
+                    idx, base,
+                    (unsigned long)(addr - (uintptr_t)info.dli_fbase),
+                    info.dli_fbase, (void *)addr);
+        }
+    } else {
+        fprintf(stderr, "[alloc]     #%d %p\n", idx, (void *)addr);
+    }
+}
+
+void alloc_trace_report(int round)
+{
+    uint64_t deltas[AT_TOP];
+    uint32_t idxs[AT_TOP];
+    uint64_t total = 0;
+    int ntop = 0;
+
+    int slot;
+
+    if (!at_enabled) {
+        return;
+    }
+    slot = at_enter();
+
+    /* Top-N sites by positive live-byte delta, plus the total. */
+    for (uint32_t i = 0; i < AT_STK_N; i++) {
+        ATStack *s = &at_stk[i];
+        int64_t d;
+
+        if (s->bytes == 0 && s->count == 0 && s->frames[0] == 0) {
+            continue;
+        }
+        d = (int64_t)s->bytes - (int64_t)at_snap[i];
+        if (d <= 0) {
+            continue;
+        }
+        total += (uint64_t)d;
+        if (ntop < AT_TOP) {
+            deltas[ntop] = (uint64_t)d;
+            idxs[ntop] = i;
+            ntop++;
+        } else {
+            /* replace the smallest in the top list */
+            int min_i = 0;
+            for (int k = 1; k < AT_TOP; k++) {
+                if (deltas[k] < deltas[min_i]) {
+                    min_i = k;
+                }
+            }
+            if ((uint64_t)d > deltas[min_i]) {
+                deltas[min_i] = (uint64_t)d;
+                idxs[min_i] = i;
+            }
+        }
+    }
+
+    fprintf(stderr, "[alloc] round %d residue: tracked_live=%llu B in %llu "
+            "allocs, leaked_since_step=%llu B over %d sites "
+            "(bad_free=%llu bad_realloc=%llu)\n",
+            round, (unsigned long long)at_live_bytes,
+            (unsigned long long)at_live_count,
+            (unsigned long long)total, ntop,
+            (unsigned long long)at_bad_free,
+            (unsigned long long)at_bad_alloc);
+    for (int k = 0; k < ntop; k++) {
+        /* selection of the k-th largest remaining */
+        int best = -1;
+        for (int j = 0; j < ntop; j++) {
+            if (idxs[j] == UINT32_MAX) {
+                continue;
+            }
+            if (best < 0 || deltas[j] > deltas[best]) {
+                best = j;
+            }
+        }
+        if (best < 0 || deltas[best] == 0) {
+            break;
+        }
+        fprintf(stderr, "[alloc] site bytes=%llu live_allocs=%llu\n",
+                (unsigned long long)deltas[best],
+                (unsigned long long)at_stk[idxs[best]].count);
+        for (int f = 0; f < AT_FRAMES; f++) {
+            at_print_frame(f, at_stk[idxs[best]].frames[f]);
+        }
+        idxs[best] = UINT32_MAX;
+    }
+    at_snapshot();
+    if (slot) {
+        at_leave(slot);
+    }
+}
+
+#else /* !__APPLE__ */
+
+#include "alloc_trace.h"
+
+int alloc_trace_start(void) { return 0; }
+void alloc_trace_step(void) { }
+void alloc_trace_report(int round) { (void)round; }
+
+#endif
diff --git a/qemu-inprocess/alloc_trace.h b/qemu-inprocess/alloc_trace.h
new file mode 100644
index 0000000000000000000000000000000000000000..dcf2b71ddced02a52df8091ef54bb50951934912
--- /dev/null
+++ b/qemu-inprocess/alloc_trace.h
@@ -0,0 +1,29 @@
+/*
+ * alloc_trace.h - diagnostic allocation attribution for the in-process QEMU
+ * lifecycle (VW_TRACE_ALLOC).
+ *
+ * License: part of the QEMU distribution, GPLv2 (see qemu-source/COPYING).
+ */
+#ifndef QEMU_INPROCESS_ALLOC_TRACE_H
+#define QEMU_INPROCESS_ALLOC_TRACE_H
+
+/*
+ * Install the malloc_logger hook and reset all state.  Returns 1 when the
+ * tracker is active, 0 when it is unavailable (non-macOS or hook missing).
+ */
+int alloc_trace_start(void);
+
+/*
+ * Record "all allocations alive right now" as the baseline for the next
+ * report (called before a lifecycle cycle's init).
+ */
+void alloc_trace_step(void);
+
+/*
+ * Report every allocation site whose live bytes grew since the last
+ * alloc_trace_step(), then move the baseline to the current state.
+ * @round is only used in the printed tag.
+ */
+void alloc_trace_report(int round);
+
+#endif
diff --git a/qemu-inprocess/headless_ui_stubs.c b/qemu-inprocess/headless_ui_stubs.c
new file mode 100644
index 0000000000000000000000000000000000000000..145164b87c615bfb2f04336aa23e9b18ece19811
--- /dev/null
+++ b/qemu-inprocess/headless_ui_stubs.c
@@ -0,0 +1,24 @@
+/*
+ * headless_ui_stubs.c - Minimal headless UI glue for the lifecycle harness.
+ *
+ * The harness runs QEMU with -nodefaults -S and never opens a display, a SPICE
+ * connection, or a console window. The archives linked into this harness do not
+ * include libui-spice, so the two SPICE presence symbols that system/vl.c
+ * references are provided here.
+ *
+ * Both are deliberately inert AND truthful for this build: SPICE is genuinely
+ * not compiled in, so reporting "no SPICE" is the correct answer, not a stub
+ * that hides a real capability. The full console/display surface comes from the
+ * real ui/console.c, which IS linked -- only SPICE is missing.
+ *
+ * This file contains NO process spawning of any kind and never starts a guest.
+ */
+#include "qemu/osdep.h"
+
+/* Forward declaration matching QEMU's opaque SPICE core handle. */
+struct QemuSpiceCore;
+typedef struct QemuSpiceCore QemuSpiceCore;
+
+/* --- SPICE: not compiled into this headless build --- */
+bool using_spice;
+QemuSpiceCore *qemu_spice;
diff --git a/qemu-inprocess/lifecycle_harness.c b/qemu-inprocess/lifecycle_harness.c
new file mode 100644
index 0000000000000000000000000000000000000000..ac02bfda03c7b034376df3575ffecae37cd80609
--- /dev/null
+++ b/qemu-inprocess/lifecycle_harness.c
@@ -0,0 +1,1453 @@
+/*
+ * lifecycle_harness.c - Dedicated in-process QEMU lifecycle acceptance harness.
+ *
+ * Goal (one host process, no child process, no guest/UTM/VM started):
+ *
+ *   phase 0  malformed init            -> must return INIT_FAILED, host survives
+ *   phase 1  full cleanup              -> qemu_cleanup() runs, session released
+ *
+ *   then LIFECYCLE_ROUNDS (>=20) consecutive rounds, EACH in the SAME PID:
+ *     create -> init(-machine virt -nodefaults -accel tcg -m 256M -S)
+ *            -> start main loop on a worker thread
+ *            -> request_stop (idempotent: a 2nd stop must return STOPPED)
+ *            -> join worker (main loop exits)
+ *            -> cleanup + destroy
+ *
+ *   final    assert NO callback fired after a session was destroyed
+ *            assert NO global state leaked (20th init still succeeds)
+ *
+ * The regression this pass fixes: qemu_init_internal() re-registered the same
+ * static QemuOptsList objects on every init, overflowing the fixed-size
+ * vm_config_groups[48] / drive_config_groups[5] tables, so the second init
+ * aborted with "ran out of space in drive_config_groups". The fix makes
+ * qemu_add_drive_opts() / qemu_add_opts() idempotent (skip if already present).
+ * This harness reproduces it directly: if the fix is missing, round 2 (or some
+ * later round) aborts or returns INIT_FAILED instead of OK.
+ *
+ * The guest is never booted: -S keeps the CPU at reset and -nodefaults creates
+ * no devices, so no firmware/OS image is ever executed. real_guest_started is
+ * therefore always false for this harness.
+ *
+ * Every meaningful step prints a machine-readable line to stderr so the
+ * acceptance run can be diffed literally, and the process exit code summarises
+ * the verdict.
+ */
+#include "qemu/osdep.h"
+#include "qemu_inprocess.h"
+#include "alloc_trace.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <pthread.h>
+#include <dirent.h>
+#include <unistd.h>
+#if defined(__APPLE__)
+#include <mach/mach.h>
+#include <mach/thread_act.h>
+#include <mach/arm/thread_status.h>
+#endif
+#if defined(__APPLE__)
+#include <malloc/malloc.h>
+#include <mach-o/dyld.h>
+#endif
+#include <execinfo.h>
+#include <signal.h>
+#include <dlfcn.h>
+#include <sys/ucontext.h>
+#include <sys/mman.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <time.h>
+
+/* qemu_init needs a real argv; these are constructed on the stack. */
+static char arg_machine[]   = "-machine";
+static char arg_virt[]      = "virt";
+static char arg_nodefaults[]= "-nodefaults";
+static char arg_accel[]     = "-accel";
+static char arg_tcg[]       = "tcg";
+static char arg_m[]         = "-m";
+static char arg_256[]       = "256M";
+static char arg_S[]         = "-S";
+static char arg_bad[]       = "--definitely-not-a-real-qemu-option";
+
+/*
+ * Acceptance requires >= 100 consecutive rounds in one PID.  The default is 100;
+ * QEMU_INPROCESS_ROUNDS overrides it for bisects.
+ */
+#define LIFECYCLE_ROUNDS_DEFAULT 100
+#define LIFECYCLE_TIMEOUT_SEC 120
+/* Safety stop: the harness aborts the run if RSS exceeds this hard cap. */
+#define LIFECYCLE_RSS_SAFETY_BYTES (1536ULL * 1024ULL * 1024ULL)
+/* No linear growth: from the sample at 1/4 of the run to the last round the RSS
+ * may drift by at most this much (allocator/plateau noise), i.e. the last 3/4 of
+ * the rounds must not add a per-round cost. */
+#define LIFECYCLE_RSS_DRIFT_MAX (24ULL * 1024ULL * 1024ULL)
+static int LIFECYCLE_ROUNDS;
+
+static int g_failures;
+static pthread_t g_main_thread;
+static unsigned long long g_rss_first, g_rss_quarter, g_rss_last;
+static volatile int g_done;          /* set when the whole harness finishes */
+static long g_cb_total;              /* callbacks observed during any run */
+static long g_cb_after_destroy;      /* callbacks observed after a session destroyed */
+
+/* Per-active-session "destroyed" flag, consulted by the callbacks. Because the
+ * harness drives everything single-threaded (worker joined before destroy), a
+ * callback that ever observes destroyed==1 proves a use-after-teardown bug. */
+static int g_destroyed;
+
+/* Callback counters (informational; the guest is headless so these should stay
+ * at zero, but we watch them regardless). */
+static long cnt_display, cnt_input, cnt_audio_out, cnt_audio_in;
+static long cnt_block_read, cnt_block_write;
+
+#define STEP(fmt, ...) fprintf(stderr, "[lifecycle] " fmt "\n", ##__VA_ARGS__)
+
+/*
+ * Diagnostic hook (VW_BT_ON_CRASH=1): print a backtrace from the thread that
+ * aborts, so an intermittent host-termination bug can be attributed even when
+ * the run is not reproducible under a debugger.  Only installed on request.
+ */
+static void crash_backtrace(int sig)
+{
+    void *frames[64];
+    int n;
+    char hdr[96];
+    int len;
+
+    len = snprintf(hdr, sizeof(hdr), "[crash] signal %d backtrace:\n", sig);
+    if (len > 0) {
+        ssize_t ignored = write(2, hdr, (size_t)len);
+        (void)ignored;
+    }
+    n = backtrace(frames, 64);
+    backtrace_symbols_fd(frames, n, 2);
+    _exit(99);
+}
+
+#if defined(__APPLE__)
+/* Bytes in use in the default malloc zone (macOS heap accounting). */
+static unsigned long long heap_in_use(void)
+{
+    malloc_statistics_t st;
+
+    malloc_zone_statistics(malloc_default_zone(), &st);
+    return (unsigned long long)st.size_in_use;
+}
+
+/* Virtual size of this process (macOS): reveals mmap churn (guest RAM). */
+static unsigned long long vm_bytes(void)
+{
+    mach_task_basic_info_data_t info;
+    mach_msg_type_number_t count = MACH_TASK_BASIC_INFO_COUNT;
+
+    if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO,
+                  (task_info_t)&info, &count) != KERN_SUCCESS) {
+        return 0;
+    }
+    return (unsigned long long)info.virtual_size;
+}
+
+/* Resident set size of this process (macOS).  0 if unavailable. */
+static unsigned long long rss_bytes(void)
+{
+    mach_task_basic_info_data_t info;
+    mach_msg_type_number_t count = MACH_TASK_BASIC_INFO_COUNT;
+
+    if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO,
+                  (task_info_t)&info, &count) != KERN_SUCCESS) {
+        return 0;
+    }
+    return (unsigned long long)info.resident_size;
+}
+
+/* Live thread count of this process (macOS): proves the lifecycle does not
+ * leak a helper thread per cycle. */
+static int live_thread_count(void)
+{
+    thread_act_array_t threads;
+    mach_msg_type_number_t n = 0;
+    int ret = -1;
+
+    if (task_threads(mach_task_self(), &threads, &n) != KERN_SUCCESS) {
+        return -1;
+    }
+    ret = (int)n;
+    for (mach_msg_type_number_t i = 0; i < n; i++) {
+        mach_port_deallocate(mach_task_self(), threads[i]);
+    }
+    vm_deallocate(mach_task_self(), (vm_address_t)threads,
+                  n * sizeof(threads[0]));
+    return ret;
+}
+
+#else
+/*
+ * Linux/OHOS fallbacks.  The macOS build uses Mach task/zone APIs; the OHOS
+ * AArch64 cross build has neither, so RSS/VM come from procfs and the heap and
+ * thread counters degrade to 0 / procfs task count.  These values are used only
+ * for diagnostics and the RSS safety/drift assertions; on OHOS the acceptance
+ * run is executed on the host build instead (see docs).
+ */
+static unsigned long long heap_in_use(void)
+{
+    return 0;
+}
+
+static unsigned long long proc_statm_field(int idx)
+{
+    unsigned long long v = 0;
+    FILE *f = fopen("/proc/self/statm", "r");
+
+    if (f) {
+        unsigned long long size = 0, resident = 0;
+
+        if (fscanf(f, "%llu %llu", &size, &resident) == 2) {
+            v = (idx == 1) ? size : resident;
+            v *= (unsigned long long)sysconf(_SC_PAGESIZE);
+        }
+        fclose(f);
+    }
+    return v;
+}
