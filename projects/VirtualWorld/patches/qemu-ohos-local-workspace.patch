+ * process, and a fatal error raised on an internal QEMU thread must be visible
+ * to the thread that owns the session.
+ */
+static int trap_armed;
+static int trap_tripped;
+static int trap_abort;
+static char trap_message[QEMU_INPROCESS_TRAP_MSG_LEN];
