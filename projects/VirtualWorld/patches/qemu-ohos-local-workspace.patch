+static void trap_store(bool is_abort, const char *src, int line,
+                       const char *func, const char *message)
+{
+    char text[QEMU_INPROCESS_TRAP_MSG_LEN];
+    const char *base = src ? strrchr(src, '/') : NULL;
+
+    base = base ? base + 1 : src;
+    snprintf(text, sizeof(text), "%s at %s:%d%s%s: %s",
+             is_abort ? "error_abort" : "error_fatal",
+             base ? base : "?", line,
+             func ? " in " : "", func ? func : "", message);
+    memcpy(trap_message, text, sizeof(trap_message));
+    trap_message[sizeof(trap_message) - 1] = '\0';
+    if (is_abort) {
+        qatomic_set(&trap_abort, 1);
+    }
+}
+
+bool qemu_inprocess_trap_record_at(const char *src, int line, const char *func,
+                                   const char *fmt, ...)
+{
+    char text[QEMU_INPROCESS_TRAP_MSG_LEN];
+    va_list ap;
