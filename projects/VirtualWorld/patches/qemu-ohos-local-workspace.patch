+/*
+ * Reset the dispatcher's global synchronisation state for a (re)initialisation.
+ *
+ * QEMU was not originally written to survive more than one qemu_init() in a
+ * single process.  In the in-process lifecycle model qemu_init()/qemu_cleanup()
+ * run many times in the same PID, so the static dispatcher globals must be put
+ * back into their initial state every time a dispatcher coroutine is (re)created
+ * in monitor_init_globals().  If they are left stale from a previous cycle the
+ * next dispatcher's first monitor_qmp_dispatcher_co() entry trips the
+ * busy==true invariant (qmp.c:354) or treats a fresh dispatcher as already
+ * shut down.
+ */
+void qmp_dispatcher_reset_globals(void)
+{
+    qatomic_set(&qmp_dispatcher_co_busy, true);
+    qatomic_set(&qmp_dispatcher_co_shutdown, false);
+    qmp_dispatcher_current_mon = NULL;
+}
+
