+/*
+ * VirtualWorld: dev-only FIRST-CORRUPTION canary (env VW_OBJ_CANARY).
+ *
+ * Walks every QOM object that is currently alive and validates every child
+ * property and every bus-child link ("child[N]" link properties) against the
+ * live-object registry.  The rare in-process teardown failure ends with a
+ * corrupted QOM child pointer being finalized/unref'd (libmalloc: "pointer
+ * being freed was not allocated"; earlier also a hang with the PC in a
+ * non-executable mapping), so detecting the FIRST invalid child property -
+ * with its owner type, property name and pointer - names the object/site that
+ * went bad instead of only the eventual victim.  Inert unless the env var is
+ * set; the caller decides whether to abort on the first hit.
+ */
+int qemu_inprocess_object_validate_all(const char *tag)
+{
+    GHashTableIter hit;
+    gpointer key;
+    int bad = 0;
+
+    if (!qemu_inprocess_live_objects) {
+        return 0;
+    }
+    g_rec_mutex_lock(&qemu_inprocess_live_lock);
+    g_hash_table_iter_init(&hit, qemu_inprocess_live_objects);
+    while (g_hash_table_iter_next(&hit, &key, NULL)) {
+        Object *obj = key;
+        ObjectPropertyIterator iter;
+        ObjectProperty *prop;
+
+        object_property_iter_init(&iter, obj);
+        while ((prop = object_property_iter_next(&iter))) {
+            Object *child = NULL;
+            const char *kind = NULL;
+
+            if (object_property_is_child(prop) && prop->opaque) {
+                child = prop->opaque;
+                kind = "child";
+            } else if (g_str_has_prefix(prop->name, "child[")
+                       && qemu_inprocess_prop_is_link(prop)) {
+                Object **targetp = qemu_inprocess_link_targetp(obj, prop);
+
+                child = targetp ? *targetp : NULL;
+                kind = "bus-child-link";
+            } else {
+                continue;
+            }
+            if (!child || !qemu_inprocess_object_is_live(child)) {
+                bad++;
+                fprintf(stderr,
+                        "[objcanary] %s BAD %s owner=%p owner_type=%s "
+                        "prop=%s child=%p child_live=%d\n",
+                        tag, kind, (void *)obj, object_get_typename(obj),
+                        prop->name, (void *)child,
+                        child && qemu_inprocess_object_is_live(child));
+            }
+        }
+    }
+    g_rec_mutex_unlock(&qemu_inprocess_live_lock);
+    if (bad) {
+        fprintf(stderr, "[objcanary] %s total_bad=%d\n", tag, bad);
+    }
+    return bad;
+}
