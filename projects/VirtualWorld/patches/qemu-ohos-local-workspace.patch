            (rom->as == item->as && rom->addr >= item->addr);
 }
 
+/*
+ * VirtualWorld: release the process-lifetime ROM list with a two-generation
+ * delay.
+ *
+ * The ROM blobs (device tree, ACPI tables, firmware) are allocated per cycle and
+ * retain ~1.1 MiB per cycle.  Freeing them at the end of the *same* cycle is not
+ * safe: a memory region/fw_cfg entry of the machine being finalized still points
+ * at the blob.  Freeing them one generation later is safe -- by then every user
+ * of the previous cycle is gone -- and it bounds the residue to one cycle's
+ * worth instead of growing linearly.
+ */
+static QTAILQ_HEAD(, Rom) retired_roms = QTAILQ_HEAD_INITIALIZER(retired_roms);
+static QTAILQ_HEAD(, Rom) pending_roms = QTAILQ_HEAD_INITIALIZER(pending_roms);
+
+void rom_release_all(void)
+{
+    Rom *rom, *next;
+
+    /* Free the generation that ended two cycles ago. */
+    QTAILQ_FOREACH_SAFE(rom, &retired_roms, next, next) {
+        QTAILQ_REMOVE(&retired_roms, rom, next);
+        rom_free(rom);
+    }
+    /* Retire this cycle's entries and promote the pending generation. */
+    QTAILQ_FOREACH_SAFE(rom, &roms, next, next) {
+        QTAILQ_REMOVE(&roms, rom, next);
+        QTAILQ_INSERT_TAIL(&pending_roms, rom, next);
+    }
+    QTAILQ_FOREACH_SAFE(rom, &pending_roms, next, next) {
+        QTAILQ_REMOVE(&pending_roms, rom, next);
+        QTAILQ_INSERT_TAIL(&retired_roms, rom, next);
+    }
+    roms_loaded = 0;
+}
