 void object_set_accelerator_compat_props(GPtrArray *compat_props)
 {
-    assert(!object_compat_props[0]);
     object_compat_props[0] = compat_props;
 }
 
diff --git a/qom/object.c b/qom/object.c
index f79b2cf3618369a87d25685b1bd834f8b2218936..5239d82d2e478d722f56dd6e25d9ff43534e3c8d 100644
--- a/qom/object.c
+++ b/qom/object.c
@@ -11,6 +11,10 @@
  */
 
 #include "qemu/osdep.h"
+#if defined(__APPLE__) || defined(__GLIBC__)
+#include <execinfo.h>
+#define VW_OBJ_LIFE_BT 1
+#endif
 #include "qapi/error.h"
 #include "qom/compat-properties.h"
 #include "qom/object.h"
@@ -89,6 +93,570 @@ static void type_table_add(TypeImpl *ti)
     g_hash_table_insert(type_table, (void *)ti->name, ti);
 }
 
+/*
+ * VirtualWorld diagnostics: track which QOM objects are still alive so a second
+ * object_finalize() on the same object (use-after-free of the object graph) is
+ * reported unambiguously instead of being confused with allocator address reuse.
+ */
+static GHashTable *qemu_inprocess_live_objects;
+static GRecMutex qemu_inprocess_live_lock;
+
+static void vw_obj_life_create(Object *obj);
+static void vw_obj_life_free(Object *obj);
+
+static void qemu_inprocess_object_mark_live(Object *obj)
+{
+    if (!qemu_inprocess_live_objects) {
+        qemu_inprocess_live_objects =
+            g_hash_table_new(g_direct_hash, g_direct_equal);
+        g_rec_mutex_init(&qemu_inprocess_live_lock);
+    }
+    g_rec_mutex_lock(&qemu_inprocess_live_lock);
+    g_hash_table_add(qemu_inprocess_live_objects, obj);
+    g_rec_mutex_unlock(&qemu_inprocess_live_lock);
+    vw_obj_life_create(obj);
+}
+
+static bool qemu_inprocess_object_was_live(Object *obj)
+{
+    bool r = false;
+
+    if (qemu_inprocess_live_objects) {
+        g_rec_mutex_lock(&qemu_inprocess_live_lock);
+        r = g_hash_table_contains(qemu_inprocess_live_objects, obj);
+        g_rec_mutex_unlock(&qemu_inprocess_live_lock);
+    }
+    return r;
+}
+
+/*
+ * VirtualWorld object-lifecycle tracing (env VW_TRACE_QOM_LIFE): stable ids,
+ * create/parent-link/unparent/free events with the current lifecycle stage
+ * (set by the harness per battery entry/round) and a freed-object backtrace, so
+ * a later dead reference can name (last valid owner -> property -> freed id).
+ */
+typedef struct VwObjLife {
+    unsigned long id;
+    Object *ptr;
+    char type[80];
+    char created_stage[48];
+    int freed;
+    char freed_stage[48];
+#ifdef VW_OBJ_LIFE_BT
+    void *bt[8];
+    int nbt;
+#endif
+} VwObjLife;
+
+static GHashTable *vw_obj_life;
+static unsigned long vw_obj_next_id = 1;
+static char vw_life_stage[48] = "startup";
+static int vw_life_trace = -1;
+
+static int vw_obj_life_on(void)
+{
+    if (vw_life_trace < 0) {
+        vw_life_trace = getenv("VW_TRACE_QOM_LIFE") != NULL;
+    }
+    return vw_life_trace;
+}
+
+static void vw_obj_life_ensure(void)
+{
+    if (!vw_obj_life) {
+        vw_obj_life = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+}
+
+void qemu_inprocess_set_life_stage(const char *stage)
+{
+    if (!stage) {
+        return;
+    }
+    snprintf(vw_life_stage, sizeof(vw_life_stage), "%s", stage);
+}
+
+static VwObjLife *vw_obj_life_lookup(Object *obj)
+{
+    if (!vw_obj_life || !obj) {
+        return NULL;
+    }
+    return g_hash_table_lookup(vw_obj_life, obj);
+}
+
+static const char *vw_obj_type_name(Object *obj)
+{
+    return (obj && obj->class && obj->class->type) ? obj->class->type->name : "?";
+}
+
+static void vw_obj_life_create(Object *obj)
+{
+    VwObjLife *r;
+
+    if (!vw_obj_life_on()) {
+        return;
+    }
+    vw_obj_life_ensure();
+    r = g_new0(VwObjLife, 1);
+    r->id = vw_obj_next_id++;
+    r->ptr = obj;
+    snprintf(r->type, sizeof(r->type), "%s", vw_obj_type_name(obj));
+    snprintf(r->created_stage, sizeof(r->created_stage), "%s", vw_life_stage);
+    g_hash_table_replace(vw_obj_life, obj, r);
+    fprintf(stderr, "[qomlife] %s CREATE id=%lu ptr=%p stage=%s\n",
+            r->type, r->id, (void *)obj, vw_life_stage);
+}
+
+static void vw_obj_life_free(Object *obj)
+{
+    VwObjLife *r = vw_obj_life_lookup(obj);
+
+    if (!vw_obj_life_on()) {
+        return;
+    }
+    if (!r) {
+        fprintf(stderr, "[qomlife] FREE without create record ptr=%p type=%s "
+                "stage=%s\n", (void *)obj, vw_obj_type_name(obj), vw_life_stage);
+        return;
+    }
+    r->freed = 1;
+    snprintf(r->freed_stage, sizeof(r->freed_stage), "%s", vw_life_stage);
+#ifdef VW_OBJ_LIFE_BT
+    r->nbt = backtrace(r->bt, ARRAY_SIZE(r->bt));
+#endif
+    fprintf(stderr, "[qomlife] %s#%lu FREE ptr=%p stage=%s\n",
+            r->type, r->id, (void *)obj, vw_life_stage);
+}
+
+static void vw_obj_life_link(Object *owner, const char *prop, Object *child)
+{
+    VwObjLife *ro, *rc;
+
+    if (!vw_obj_life_on()) {
+        return;
+    }
+    ro = vw_obj_life_lookup(owner);
+    rc = vw_obj_life_lookup(child);
+    fprintf(stderr, "[qomlife] LINK owner=%s#%lu(%p) prop=%s child=%s#%lu(%p) "
+            "stage=%s\n", vw_obj_type_name(owner), ro ? ro->id : 0,
+            (void *)owner, prop ? prop : "?", vw_obj_type_name(child),
+            rc ? rc->id : 0, (void *)child, vw_life_stage);
+}
+
+static void vw_obj_life_unlink(Object *owner, Object *child, const char *how)
+{
+    VwObjLife *ro, *rc;
+
+    if (!vw_obj_life_on()) {
+        return;
+    }
+    ro = vw_obj_life_lookup(owner);
+    rc = vw_obj_life_lookup(child);
+    fprintf(stderr, "[qomlife] UNLINK(%s) owner=%s#%lu(%p) child=%s#%lu(%p) "
+            "stage=%s\n", how ? how : "?", vw_obj_type_name(owner),
+            ro ? ro->id : 0, (void *)owner, vw_obj_type_name(child),
+            rc ? rc->id : 0, (void *)child, vw_life_stage);
+}
+
+static void vw_obj_life_dead_ref(Object *owner, const char *prop, Object *dead,
+                                 const char *where)
+{
+    VwObjLife *ro = vw_obj_life_lookup(owner);
+    VwObjLife *rd = vw_obj_life_lookup(dead);
+
+    if (!vw_obj_life_on()) {
+        return;
+    }
+    fprintf(stderr, "[qomlife] DEAD REF at %s\n", where ? where : "?");
+    fprintf(stderr, "[qomlife]   last valid owner: %s#%lu ptr=%p parent=%p\n",
+            vw_obj_type_name(owner), ro ? ro->id : 0, (void *)owner,
+            (void *)((owner && owner->parent) ? owner->parent : NULL));
+    fprintf(stderr, "[qomlife]   property: %s -> dead ptr=%p\n",
+            prop ? prop : "?", (void *)dead);
+    if (rd) {
+        fprintf(stderr, "[qomlife]   freed object: %s#%lu freed_at_stage=%s\n",
+                rd->type, rd->id, rd->freed_stage);
+#ifdef VW_OBJ_LIFE_BT
+        fprintf(stderr, "[qomlife]   free backtrace:\n");
+        backtrace_symbols_fd(rd->bt, rd->nbt, 2);
+#endif
+    } else {
+        fprintf(stderr, "[qomlife]   freed object has no record\n");
+    }
+    fprintf(stderr, "[qomlife]   current stage=%s\n", vw_life_stage);
+}
+
+/*
+ * VirtualWorld: live-object probes for the in-process lifecycle acceptance
+ * harness.  A completed create/init/run/stop/cleanup/destroy cycle must not grow
+ * the live QOM population; the census (env-gated in the harness) is used to find
+ * which types survive a cycle.
+ */
+unsigned qemu_inprocess_object_refcount(Object *obj)
+{
+    return obj->ref;
+}
+
+/*
+ * Print @obj's properties, and for link properties the target's type and
+ * refcount.  Used to find the reference cycle that keeps a retired machine tree
+ * alive (in-process lifecycle teardown).
+ */
+/* Find live objects that reference @target through a link/child property. */
+void qemu_inprocess_find_referrers(Object *target)
+{
+    GHashTableIter it;
+    gpointer key, val;
+
+    if (!target || !qemu_inprocess_live_objects) {
+        return;
+    }
+    g_rec_mutex_lock(&qemu_inprocess_live_lock);
+    g_hash_table_iter_init(&it, qemu_inprocess_live_objects);
+    while (g_hash_table_iter_next(&it, &key, &val)) {
+        Object *holder = key;
+        GHashTableIter pit;
+        gpointer pk, pv;
+
+        if (holder == target) {
+            continue;
+        }
+        g_hash_table_iter_init(&pit, holder->properties);
+        while (g_hash_table_iter_next(&pit, &pk, &pv)) {
+            ObjectProperty *prop = pv;
+            Object *t;
+
+            if (!prop->type || !(strstr(prop->type, "link") ||
+                                 strstr(prop->type, "child"))) {
+                continue;
+            }
