+        fprintf(stderr, "[vwmutex] %s m=%p known=%d init_site=%p %s+0x%lx "
+                "destroyed_before=%d self=%p init_flag=%d bytes=",
+                tag, m, e != NULL, e ? e->init_site : NULL, isym, ioff,
+                e ? e->destroyed : -1, (void *)pthread_self(),
+                (int)((QemuMutex *)m)->initialized);
+        {
+            const unsigned char *b = (const unsigned char *)m;
+            int k;
+
+            for (k = 0; k < 32; k++) {
