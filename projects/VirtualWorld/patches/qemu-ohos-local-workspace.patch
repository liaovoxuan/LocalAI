+ *
+ * The in-process lifecycle occasionally aborts in qemu_mutex_destroy() with
+ * `assert(mutex->initialized)` after the malformed-battery entry-8 cleanup.
+ * This registry records the creation site of every mutex and flags destroys so
+ * the failure report can name the object address, its creation site and the
+ * destroy path (full backtrace).  It is inert unless the env var is set.
+ */
+#if defined(__APPLE__) || defined(__GLIBC__)
+#define VW_HAVE_EXECINFO 1
+#include <execinfo.h>
+#endif
+#include <dlfcn.h>
+
+#define VW_MUTEX_SITES 8192
+typedef struct VwMutexSite {
+    void *m;
+    void *init_site;
+    int destroyed;
+} VwMutexSite;
+static VwMutexSite vw_mutex_sites[VW_MUTEX_SITES];
+static unsigned vw_mutex_site_count;
+static int vw_mutex_trace = -1;
+
+static int vw_mutex_tracing(void)
+{
+    if (vw_mutex_trace < 0) {
+        vw_mutex_trace = getenv("VW_TRACE_MUTEX") != NULL;
+    }
+    return vw_mutex_trace;
+}
+
+static void vw_mutex_register(void *m, void *site)
+{
+    unsigned i;
+
+    if (!vw_mutex_tracing()) {
+        return;
+    }
+    for (i = 0; i < vw_mutex_site_count; i++) {
+        if (vw_mutex_sites[i].m == m) {
+            vw_mutex_sites[i].init_site = site;
+            vw_mutex_sites[i].destroyed = 0;
+            return;
+        }
+    }
+    if (vw_mutex_site_count < VW_MUTEX_SITES) {
+        vw_mutex_sites[vw_mutex_site_count].m = m;
+        vw_mutex_sites[vw_mutex_site_count].init_site = site;
+        vw_mutex_sites[vw_mutex_site_count].destroyed = 0;
+        vw_mutex_site_count++;
+    }
+}
+
+static VwMutexSite *vw_mutex_find(void *m)
+{
+    unsigned i;
+
+    for (i = 0; i < vw_mutex_site_count; i++) {
+        if (vw_mutex_sites[i].m == m) {
+            return &vw_mutex_sites[i];
+        }
+    }
+    return NULL;
+}
+
+static void vw_mutex_report(const char *tag, void *m)
+{
