+            && ms->rp_state.rp_sem.mutex.initialized
+            && ms->rp_state.rp_pong_acks.mutex.initialized
+            && ms->postcopy_qemufile_src_sem.mutex.initialized
+            && ms->error_mutex.initialized && ms->qemu_file_lock.initialized
+            && mis->rp_mutex.initialized
+            && mis->postcopy_pause_sem_dst.mutex.initialized
+            && mis->page_request_mutex.initialized
+            && mis->page_request_cond.initialized;
+    }
+    fprintf(stderr, "[migcheck] %s ok=%d self=%p ms=%p mis=%p "
+            "msem=%d,%d,%d,%d,%d,%d mmx=%d,%d imx=%d,%d,%d,%d\n", tag,
+            (int)ok, (void *)pthread_self(), (void *)ms, (void *)mis,
+            ms ? (int)ms->wait_unplug_sem.mutex.initialized : -1,
+            ms ? (int)ms->rate_limit_sem.mutex.initialized : -1,
+            ms ? (int)ms->postcopy_pause_sem.mutex.initialized : -1,
+            ms ? (int)ms->rp_state.rp_sem.mutex.initialized : -1,
+            ms ? (int)ms->rp_state.rp_pong_acks.mutex.initialized : -1,
+            ms ? (int)ms->postcopy_qemufile_src_sem.mutex.initialized : -1,
+            ms ? (int)ms->error_mutex.initialized : -1,
+            ms ? (int)ms->qemu_file_lock.initialized : -1,
+            mis ? (int)mis->rp_mutex.initialized : -1,
+            mis ? (int)mis->postcopy_pause_sem_dst.mutex.initialized : -1,
+            mis ? (int)mis->page_request_mutex.initialized : -1,
+            mis ? (int)mis->page_request_cond.initialized : -1);
+}
