+        fprintf(stderr, "[vwqom] DEAD PARENT %p (prop=%s child=%p)\n",
+                (void *)parent, prop ? prop->name : "?", (void *)child);
+        abort();
+    }
+    if (child && !qemu_inprocess_object_is_live(child)) {
+        fprintf(stderr, "[vwqom] DEAD CHILD parent=%s(%p) prop=%s child=%p\n",
