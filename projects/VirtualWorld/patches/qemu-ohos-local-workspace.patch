+/*
+ * VirtualWorld: release the process-lifetime incoming-migration state.
+ *
+ * The struct itself is never freed upstream because the process exits right
+ * after migration_shutdown().  When QEMU is embedded, the same PID runs many
+ * init/cleanup cycles, so it has to be released to keep
+ * migration_object_init() from tripping its "can only be called once"
+ * assertion and to avoid leaking one state per cycle.
+ */
+static MigrationIncomingState *mig_inprocess_last_freed;
+static bool mig_inprocess_last_freed_valid;
+
+static void migration_incoming_state_release(void)
+{
+    MigrationIncomingState *mis = current_incoming;
+
+    if (!mis) {
+        return;
+    }
+    if (mig_inprocess_last_freed_valid && mis == mig_inprocess_last_freed &&
+        getenv("VW_TRACE_MIG")) {
+        fprintf(stderr, "[mig] DOUBLE RELEASE of freed mis=%p\n", (void *)mis);
+    }
+    if (getenv("VW_TRACE_MIG")) {
+        fprintf(stderr, "[mig] release mis=%p self=%p state=%d "
+                "sems(mx/cd): dst=%d/%d fault=%d/%d fast=%d/%d done=%d/%d "
+                "rp_mutex=%d prio_mutex=%d page_mutex=%d page_cond=%d\n",
+                (void *)mis, (void *)pthread_self(), (int)mis->state,
+                mis->postcopy_pause_sem_dst.mutex.initialized,
+                mis->postcopy_pause_sem_dst.cond.initialized,
+                mis->postcopy_pause_sem_fault.mutex.initialized,
+                mis->postcopy_pause_sem_fault.cond.initialized,
+                mis->postcopy_pause_sem_fast_load.mutex.initialized,
+                mis->postcopy_pause_sem_fast_load.cond.initialized,
+                mis->postcopy_qemufile_dst_done.mutex.initialized,
+                mis->postcopy_qemufile_dst_done.cond.initialized,
+                mis->rp_mutex.initialized,
+                mis->postcopy_prio_thread_mutex.initialized,
+                mis->page_request_mutex.initialized,
+                mis->page_request_cond.initialized);
+    }
+    current_incoming = NULL;
+
+    /* Fields already released by migration_incoming_state_destroy() are NULL. */
+    if (mis->postcopy_remote_fds) {
+        g_array_free(mis->postcopy_remote_fds, TRUE);
+    }
+    if (mis->page_requested) {
+        g_tree_destroy(mis->page_requested);
+    }
+#define VW_MIG_STEP(step)                                                    \
+    do {                                                                     \
+        if (getenv("VW_TRACE_MIG")) {                                        \
+            fprintf(stderr, "[mig] release step=%s\n", (step));             \
+        }                                                                    \
+    } while (0)
+    VW_MIG_STEP("rp_mutex");
+    qemu_mutex_destroy(&mis->rp_mutex);
+    VW_MIG_STEP("prio_mutex");
+    qemu_mutex_destroy(&mis->postcopy_prio_thread_mutex);
+    VW_MIG_STEP("load_event");
+    qemu_event_destroy(&mis->main_thread_load_event);
+    VW_MIG_STEP("sem_dst");
+    qemu_sem_destroy(&mis->postcopy_pause_sem_dst);
+    VW_MIG_STEP("sem_fault");
+    qemu_sem_destroy(&mis->postcopy_pause_sem_fault);
+    VW_MIG_STEP("sem_fast");
+    qemu_sem_destroy(&mis->postcopy_pause_sem_fast_load);
+    VW_MIG_STEP("sem_done");
+    qemu_sem_destroy(&mis->postcopy_qemufile_dst_done);
+    VW_MIG_STEP("page_mutex");
+    qemu_mutex_destroy(&mis->page_request_mutex);
+    VW_MIG_STEP("page_cond");
+    qemu_cond_destroy(&mis->page_request_cond);
+    VW_MIG_STEP("free");
+#undef VW_MIG_STEP
