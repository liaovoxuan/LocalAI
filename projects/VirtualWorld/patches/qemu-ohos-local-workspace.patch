+void qemu_inprocess_trap_arm(void)
+{
+    trap_message[0] = '\0';
+    qatomic_set(&trap_tripped, 0);
+    qatomic_set(&trap_abort, 0);
+    qatomic_set(&trap_armed, 1);
+}
+
+void qemu_inprocess_trap_disarm(void)
+{
+    qatomic_set(&trap_armed, 0);
+    qemu_inprocess_trap_clear();
+}
+
+void qemu_inprocess_trap_clear(void)
+{
+    trap_message[0] = '\0';
+    qatomic_set(&trap_tripped, 0);
+    qatomic_set(&trap_abort, 0);
+}
+
+bool qemu_inprocess_trap_armed(void)
+{
+    return qatomic_read(&trap_armed);
+}
+
+bool qemu_inprocess_trap_tripped(void)
+{
+    return qatomic_read(&trap_tripped);
+}
+
+bool qemu_inprocess_trap_was_abort(void)
+{
+    return qatomic_read(&trap_abort);
+}
+
