+/* ------------------------------------------------------------------
+ * Public entry points.
+ *
+ * qemu_init() keeps the upstream contract exactly: fatal configuration
+ * errors still terminate the process, which is what a standalone
+ * qemu-system binary must do.
+ *
+ * qemu_init_checked() is the in-process entry point. It returns 0 on
+ * success and non-zero on a fatal configuration error, writing a
+ * diagnostic into *fail. It never calls exit()/abort() for the fatal
+ * paths it converts, and it uses no setjmp/longjmp, so every frame
+ * unwinds normally and no cleanup is skipped.
+ * ------------------------------------------------------------------ */
+void qemu_init(int argc, char **argv)
+{
+    QemuInitFailure *unused = NULL;
+    if (qemu_init_internal(argc, argv, false, unused) != 0) {
+        /* Unreachable: !checked means every fatal path already exited. */
+        exit(EXIT_FAILURE);
+    }
+}
+
+static int qemu_inprocess_canary_seq;
+
+int qemu_init_checked(int argc, char **argv, QemuInitFailure *fail)
+{
+    int rc;
+
+    if (fail != NULL) {
+        fail->message[0] = '\0';
+    }
+    /*
+     * VW_ENABLE_QEMU_OHOS: this is the in-process entry point.  Defer the
+     * autostart (qmp_cont) of a non-(-S) machine to qemu_inprocess_run().
+     */
+    qemu_inprocess_defer_autostart = true;
+    qemu_inprocess_pending_autostart = false;
+    if (getenv("VW_OBJ_CANARY")) {
+        char tag[64];
+
+        snprintf(tag, sizeof(tag), "pre-init#%d", ++qemu_inprocess_canary_seq);
+        if (qemu_inprocess_object_validate_all(tag)
+            && getenv("VW_OBJ_CANARY_ABORT")) {
+            fprintf(stderr, "[objcanary] %s: aborting on first corruption\n",
+                    tag);
+            abort();
+        }
+    }
+    rc = qemu_init_internal(argc, argv, true, fail);
+    /*
+     * A failed init may already have built part of the machine (accelerator or
+     * device setup, for example).  Release that partial per-cycle state exactly
+     * as qemu_cleanup() does, so a failed init cannot poison the next one.  The
+     * trap is still armed here: the teardown must not be able to kill the host
+     * either, and the first recorded failure is preserved (later errors are
+     * dropped).
+     */
+    if (rc != 0) {
+        qemu_inprocess_cycle_teardown();
+        qemu_inprocess_sweep_stale_bus_children(0);
+        if (getenv("VW_OBJ_CANARY")) {
+            char tag[64];
+            int bad;
+
+            snprintf(tag, sizeof(tag), "init-failed#%d",
+                     qemu_inprocess_canary_seq);
+            bad = qemu_inprocess_object_validate_all(tag);
+            if (bad && getenv("VW_OBJ_CANARY_ABORT")) {
+                fprintf(stderr, "[objcanary] %s: aborting on first corruption "
+                        "(%d)\n", tag, bad);
+                abort();
+            }
+        }
+    } else {
+        /* A successful init can attach/detach devices on the process-lifetime
+         * buses; remove any link property left pointing at a freed device
