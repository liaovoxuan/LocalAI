+#if defined(__APPLE__) && defined(__aarch64__)
+/*
+ * Decode and emulate an AArch64 store that hit the read-only guarded page but
+ * is not the watched range.  Returns 1 on success (store performed, *next_pc
+ * advanced), 0 when the instruction is not one of the supported store forms.
+ * Only plain stores are supported: STR/STRB/STRH/STRW (and the unscaled/pre/
+ * post-index forms STUR/STR/W).  Anything else (atomics, SIMD, memcpy loops) is
+ * reported as undecodable and fails the run.
+ */
+static int vw_guard_emulate_store(void *uc)
+{
+    ucontext_t *u = (ucontext_t *)uc;
+    unsigned long long pc = u->uc_mcontext->__ss.__pc;
+    const unsigned char *p = (const unsigned char *)(uintptr_t)pc;
+    unsigned long long insn = (unsigned long long)p[0] |
+        ((unsigned long long)p[1] << 8) |
+        ((unsigned long long)p[2] << 16) |
+        ((unsigned long long)p[3] << 24);
+    unsigned rt, rn, size, width;
+    long long off;
+    unsigned long long rn_val, rt_val;
+    unsigned char *ea;
+    int pre_index = 0, post_index = 0;
+
+    rn = (insn >> 5) & 0x1f;
+    rt = insn & 0x1f;
+    rn_val = u->uc_mcontext->__ss.__x[rn];
+    rt_val = u->uc_mcontext->__ss.__x[rt];
+
+    /* Unsigned-offset forms: opc=00, V=0, bits[31:24]=0b11/10/01/00 111 00 1 */
+    if ((insn & 0xFFC00000ULL) == 0xF9000000ULL) {          /* STR (uoff) 64 */
+        size = 3; off = ((insn >> 10) & 0xfff) << 3;
+    } else if ((insn & 0xFFC00000ULL) == 0xB9000000ULL) {   /* STR (uoff) 32 */
+        size = 2; off = ((insn >> 10) & 0xfff) << 2;
+    } else if ((insn & 0xFFC00000ULL) == 0x39000000ULL) {   /* STRB */
+        size = 0; off = ((insn >> 10) & 0xfff);
+    } else if ((insn & 0xFFC00000ULL) == 0x79000000ULL) {   /* STRH */
+        size = 1; off = ((insn >> 10) & 0xfff) << 1;
+    } else if ((insn & 0xFFE00C00ULL) == 0xF8000000ULL) {   /* STR unscaled */
+        size = 3; off = (long long)(int)((insn >> 12) & 0x1ff);
+        if (off & 0x100) {
+            off -= 0x200;
+        }
+    } else if ((insn & 0xFFE00C00ULL) == 0xF8000400ULL) {   /* STR post */
+        size = 3; off = (long long)(int)((insn >> 12) & 0x1ff);
+        if (off & 0x100) {
+            off -= 0x200;
+        }
+        post_index = 1;
+    } else if ((insn & 0xFFE00C00ULL) == 0xF8000C00ULL) {   /* STR pre */
+        size = 3; off = (long long)(int)((insn >> 12) & 0x1ff);
+        if (off & 0x100) {
+            off -= 0x200;
+        }
+        pre_index = 1;
+    } else {
+        return 0;
+    }
+    width = 1u << size;
+
+    ea = (unsigned char *)(uintptr_t)(rn_val + off);
+    if (pre_index) {
+        u->uc_mcontext->__ss.__x[rn] = rn_val + off;
+    }
+    if (post_index) {
+        u->uc_mcontext->__ss.__x[rn] = rn_val + off;
+        ea = (unsigned char *)(uintptr_t)rn_val;
+    }
+
+    vw_guard_buf_n = 0;
+    vw_guard_putstr("[guard] EMULATED-SAME-PAGE store pc=");
+    vw_guard_puthex(pc);
+    vw_guard_putstr(" addr=");
+    vw_guard_puthex((unsigned long long)(uintptr_t)ea);
+    vw_guard_putstr(" width=");
+    vw_guard_puthex(width);
+    vw_guard_putregs(rn_val, rt_val, 0, 0);
+    vw_guard_putstr("\n");
+    vw_guard_emit();
+
+    vw_guard_protect(1);
+    {
+        unsigned long long v = rt_val;
+        size_t i;
+
+        for (i = 0; i < width; i++) {
+            ea[i] = (unsigned char)(v & 0xff);
+            v >>= 8;
+        }
+    }
+    vw_guard_protect(0);
+    u->uc_mcontext->__ss.__pc = pc + 4;
+    return 1;
+}
+#endif
+
+static void vw_guard_signal(int sig, siginfo_t *si, void *uc)
+{
+    unsigned char *addr = (unsigned char *)si->si_addr;
+    int in_page = vw_guard_page && addr >= (unsigned char *)vw_guard_page &&
+        addr < (unsigned char *)vw_guard_page + vw_guard_len;
+    int in_target = vw_guard_target && addr >= vw_guard_target &&
+        addr < vw_guard_target + vw_guard_target_len;
+
+    vw_guard_buf_n = 0;
+    if (!in_page) {
+        vw_guard_putstr("[guard] OTHER-FAULT addr=");
+        vw_guard_puthex((unsigned long long)(uintptr_t)si->si_addr);
+        vw_guard_putstr(" stage=");
+        vw_guard_putstr(vw_guard_stage);
+        vw_guard_putstr(" sig=");
+        vw_guard_puthex((unsigned long long)sig);
+        vw_guard_putstr("\n");
+        vw_guard_emit();
+        _exit(98);
+    }
+    if (!in_target) {
+#if defined(__APPLE__) && defined(__aarch64__)
+        if (vw_guard_emulate_store(uc)) {
+            return;         /* store emulated; protection kept, monitoring on */
+        }
+        vw_guard_putstr("[guard] UNDECODABLE-SAME-PAGE store pc=");
+        {
+            ucontext_t *u = (ucontext_t *)uc;
+
+            vw_guard_puthex((unsigned long long)u->uc_mcontext->__ss.__pc);
+        }
+        vw_guard_putstr(" addr=");
+        vw_guard_puthex((unsigned long long)(uintptr_t)si->si_addr);
+        vw_guard_putstr(" stage=");
+        vw_guard_putstr(vw_guard_stage);
+        vw_guard_putstr("\n");
+        vw_guard_emit();
+        _exit(99);
+#else
+        vw_guard_putstr("[guard] SAME-PAGE-UNSUPPORTED addr=");
+        vw_guard_puthex((unsigned long long)(uintptr_t)si->si_addr);
+        vw_guard_putstr("\n");
+        vw_guard_emit();
+        _exit(99);
+#endif
+    }
+    {
+        unsigned long long pc = 0;
+
+#if defined(__APPLE__) && defined(__aarch64__)
+        if (uc) {
+            ucontext_t *u = (ucontext_t *)uc;
+
+            pc = (unsigned long long)u->uc_mcontext->__ss.__pc;
+        }
+#elif defined(__APPLE__) && defined(__x86_64__)
+        if (uc) {
+            ucontext_t *u = (ucontext_t *)uc;
+
+            pc = (unsigned long long)u->uc_mcontext->__ss.__rip;
+        }
+#endif
+        vw_guard_putstr("[guard] GUARD ILLEGAL-WRITE thread=");
+        vw_guard_puthex((unsigned long long)(uintptr_t)pthread_self());
+        vw_guard_putstr(" addr=");
+        vw_guard_puthex((unsigned long long)(uintptr_t)si->si_addr);
+        vw_guard_putstr(" pc=");
+        vw_guard_puthex(pc);
+        vw_guard_putstr(" slide=");
+        vw_guard_puthex((unsigned long long)vw_guard_slide);
+        vw_guard_putstr(" stage=");
+        vw_guard_putstr(vw_guard_stage);
+        vw_guard_putstr(" sig=");
+        vw_guard_puthex((unsigned long long)sig);
+        vw_guard_putstr("\n");
+        vw_guard_emit();
+    }
+    _exit(97);
+}
+
+static void vw_guard_install(void)
+{
+    struct sigaction sa;
+
+    if (!vw_guard_on()) {
+        return;
+    }
+#if defined(__APPLE__)
+    {
+        vw_guard_slide = (long)_dyld_get_image_vmaddr_slide(0);
+        fprintf(stderr, "[guard] armed: image slide=0x%lx\n", vw_guard_slide);
+    }
+#endif
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = vw_guard_signal;
+    sa.sa_flags = SA_SIGINFO;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGSEGV, &sa, NULL);
+    sigaction(SIGBUS, &sa, NULL);
+}
+
+/*
+ * Synthetic validation (VW_GUARD_SELFTEST=1): same-page store must be emulated
+ * and its value visible, then a store into the watched range must be caught.
+ * Exits 97 (caught), 98/99 (guard failure) or 0 on unexpected pass-through.
+ */
+static void vw_guard_selftest(void)
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+    long ps = sysconf(_SC_PAGESIZE);
+    unsigned char *mem = mmap(NULL, (size_t)ps, PROT_READ | PROT_WRITE,
+                              MAP_PRIVATE | MAP_ANON, -1, 0);
+    volatile unsigned long *legit;
+    volatile unsigned long *watched;
+
+    if (mem == MAP_FAILED) {
+        fprintf(stderr, "[selftest] mmap failed\n");
+        _exit(95);
+    }
+    vw_guard_page = mem;
+    vw_guard_len = (size_t)ps;
+    vw_guard_target = mem + 0x100;
+    vw_guard_target_len = VW_GUARD_QEMU_MUTEX_BYTES;
+    snprintf(vw_guard_stage, sizeof(vw_guard_stage), "selftest");
+    legit = (volatile unsigned long *)(mem + 0x10);
+    watched = (volatile unsigned long *)(mem + 0x100);
+    vw_guard_protect(0);
+    fprintf(stderr, "[selftest] armed page=%p target=%p\n", mem,
+            (void *)vw_guard_target);
+    *legit = 0x1122334455667788UL;          /* same page, not watched */
+    if (*legit != 0x1122334455667788UL) {
+        fprintf(stderr, "[selftest] FAIL: emulated store value wrong\n");
+        _exit(94);
+    }
+    fprintf(stderr, "[selftest] legit-store-emulated-and-visible OK\n");
+    *watched = 0xdeadbeefUL;                /* watched range -> must fault */
+    fprintf(stderr, "[selftest] FAIL: watched store was not caught\n");
+    _exit(0);
+#else
+    fprintf(stderr, "[selftest] unsupported host\n");
+    _exit(93);
+#endif
+}
