+    if (!qatomic_read(&trap_armed)) {
+        return false;
+    }
+    snprintf(text, sizeof(text), "%s%s", err->msg ? err->msg : "(no message)",
+             err->hint ? err->hint->str : "");
+    if (qatomic_cmpxchg(&trap_tripped, 0, 1) == 0) {
+        trap_store(is_abort, err->src, err->line, err->func, text);
+    }
+    return true;
+}
