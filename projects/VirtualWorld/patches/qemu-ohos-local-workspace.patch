diff --git a/include/system/inprocess-fatal.h b/include/system/inprocess-fatal.h
new file mode 100644
index 0000000000000000000000000000000000000000..29a919b77bde32cd14350f1a7c5efff65beab3a0
--- /dev/null
+++ b/include/system/inprocess-fatal.h
@@ -0,0 +1,107 @@
+/*
+ * VirtualWorld: structured fatal-error sink for in-process QEMU.
+ *
+ * Background
+ * ----------
+ * QEMU reports unrecoverable errors in two ways that both terminate the host
+ * process:
+ *
+ *   * the sentinel error pointers `error_fatal` / `error_abort`
+ *     (util/error.c::error_handle() calls exit(1) / abort()), and
+ *   * direct exit()/abort() calls scattered through the code base.
+ *
+ * That is correct for a standalone qemu-system binary, but when QEMU is linked
+ * into a host application (VirtualWorld / HarmonyOS HAP) such a path kills the
+ * host.  None of the usual escape hatches are acceptable in this code base:
+ * fork()/subprocess, signal handlers and setjmp/longjmp are all forbidden,
+ * and neither abort() nor a failure may be swallowed or reported as success.
+ *
+ * This sink is the replacement: a process-wide, explicitly armed trap that
+ *
+ *   1. converts a fatal error into a *recorded structured failure* (source
+ *      file, line, function and message) and returns to the caller instead of
+ *      exiting or aborting, and
+ *   2. lets the checked in-process entry point -- qemu_init_checked() -- turn
+ *      that record into a normal non-zero return with a diagnostic, at the
+ *      next checkpoint, with no stack frame skipped.
+ *
+ * The trap is armed only for the duration of a checked in-process
+ * initialisation.  When it is not armed every call site keeps byte-for-byte
+ * upstream behaviour (exit()/abort()), so a normal qemu-system build is
+ * unaffected.
+ *
+ * Only one in-process QEMU instance exists per process, so the trap is
+ * process-wide rather than per-thread: a fatal error raised on an internal
+ * QEMU thread (AIO, vCPU) must be visible to the init thread that owns the
+ * session.
+ *
+ * License: the QEMU project is GPLv2 (see qemu-source/COPYING). This file is
+ * part of the QEMU distribution and is distributed under the same terms.
+ */
+#ifndef SYSTEM_INPROCESS_FATAL_H
+#define SYSTEM_INPROCESS_FATAL_H
+
+#include "qemu/compiler.h"
+
+/* Longest recorded diagnostic, including the "file:line func: " prefix. */
+#define QEMU_INPROCESS_TRAP_MSG_LEN 768
+
+/*
+ * Arm the trap.  Called by the checked entry point immediately before it
+ * starts an in-process qemu_init().  Arming is idempotent and also clears any
+ * previous record, so a fresh init never inherits a stale failure.
+ */
+void qemu_inprocess_trap_arm(void);
+
+/* Disarm the trap and forget the record. */
+void qemu_inprocess_trap_disarm(void);
+
+/* Forget the recorded failure but leave the armed state untouched. */
+void qemu_inprocess_trap_clear(void);
+
+/* Is a checked in-process initialisation currently active? */
+bool qemu_inprocess_trap_armed(void);
+
+/* Did a fatal path fire while the trap was armed? */
+bool qemu_inprocess_trap_tripped(void);
+
+/*
+ * Was the recorded failure an `error_abort` (invariant violation) rather than
+ * a `error_fatal` (configuration/behavioural) failure?  Informational: both
+ * make the initialisation fail, but the distinction matters when triaging.
+ */
+bool qemu_inprocess_trap_was_abort(void);
+
+/*
+ * Recorded diagnostic, or "" when nothing was recorded.  Never NULL.  Valid
+ * until the next arm/disarm/clear.
+ */
+const char *qemu_inprocess_trap_message(void);
+
+/*
+ * Record a structured fatal failure.
+ *
+ * Returns true when the trap was armed: the caller must then stop the current
+ * operation and unwind by returning (it must NOT continue as if the failure
+ * had not happened, and must NOT report success).
+ *
+ * Returns false when no trap is armed: the caller must keep its original
+ * fatal behaviour (exit()/abort()); this preserves standalone qemu-system
+ * semantics.
+ *
+ * Only the first failure is recorded; later ones are dropped so the report
+ * points at the first real cause.
+ */
+bool qemu_inprocess_trap_record_at(const char *src, int line, const char *func,
+                                   const char *fmt, ...)
+    __attribute__((format(printf, 4, 5)));
+
+/*
+ * qemu_inprocess_trap_record("drive_config_groups full") -- records the
+ * failure together with this call site's file, line and function.
+ */
+#define qemu_inprocess_trap_record(fmt, ...)                             \
+    qemu_inprocess_trap_record_at(__FILE__, __LINE__, __func__, fmt,     \
+                                  ##__VA_ARGS__)
+
+#endif /* SYSTEM_INPROCESS_FATAL_H */
